<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sable.App.NewDocumentWindow"
        Width="300" Height="270"
        Background="{DynamicResource ChromePanel}"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="New Document">
    <Border Padding="14">
        <StackPanel Spacing="10">
            <TextBlock Text="New Document" Classes="panelHeader" Padding="0" />

            <StackPanel Spacing="4">
                <TextBlock Text="Preset" Classes="adjLabel" />
                <ComboBox x:Name="PresetCombo" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnPreset">
                    <ComboBoxItem>Custom</ComboBoxItem>
                    <ComboBoxItem>Square 1024</ComboBoxItem>
                    <ComboBoxItem>HD 1920 × 1080</ComboBoxItem>
                    <ComboBoxItem>4K 3840 × 2160</ComboBoxItem>
                    <ComboBoxItem>A4 @ 300 DPI</ComboBoxItem>
                    <ComboBoxItem>Instagram 1080</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Width (px)" Classes="adjLabel" />
                    <NumericUpDown x:Name="WBox" Minimum="1" Maximum="16384" Value="1920" Increment="1" FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Height (px)" Classes="adjLabel" />
                    <NumericUpDown x:Name="HBox" Minimum="1" Maximum="16384" Value="1080" Increment="1" FormatString="0" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock Text="DPI" Classes="adjLabel" />
                <NumericUpDown x:Name="DpiBox" Minimum="1" Maximum="2400" Value="96" Increment="1" FormatString="0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Classes="opt" Padding="14,0" Click="OnCancel" />
                <Button Content="Create" Classes="opt" Padding="14,0" Click="OnCreate" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
