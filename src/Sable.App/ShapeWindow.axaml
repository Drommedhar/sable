<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Sable.App.Localization"
        xmlns:vm="clr-namespace:Sable.UI.ViewModels;assembly=Sable.UI"
        xmlns:local="clr-namespace:Sable.App"
        x:Class="Sable.App.ShapeWindow"
        x:DataType="vm:DocumentViewModel"
        Width="290" Height="380"
        Background="{DynamicResource ChromePanel}"
        CanResize="True"
        ShowInTaskbar="False"
        Title="{loc:Loc shapeWindow.shape}">

    <DockPanel LastChildFill="True">
        <!-- header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeHeaderBg}" Padding="10,7">
            <TextBlock Text="{Binding SelectedLayer.Name}" Classes="panelHeader" Padding="0"
                       Foreground="{DynamicResource ChromeText}" FontWeight="SemiBold" />
        </Border>

        <!-- footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeFooter}" Padding="10,8">
            <Button Content="{loc:Loc shapeWindow.close}" HorizontalAlignment="Right" Click="OnClose" />
        </Border>

        <!-- thin floating wrapper; the editor lives in the reusable ShapePanel (also embedded
             in the right panel) so there is a single source of truth. -->
        <local:ShapePanel />
    </DockPanel>
</Window>
