<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sable.App"
        x:Class="Sable.App.SettingsWindow"
        Width="780" Height="560"
        Background="{DynamicResource ChromePanel}"
        WindowStartupLocation="CenterOwner"
        Title="Settings">
    <DockPanel LastChildFill="True">

        <!-- bottom bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromePanel3}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Classes="opt" Padding="16,0" Click="OnCancel" />
                <Button Content="OK" Classes="opt" Padding="20,0" Click="OnOk" />
            </StackPanel>
        </Border>

        <!-- left: search + category list -->
        <Border DockPanel.Dock="Left" Width="190" Background="{DynamicResource ChromeFooter}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <TextBox DockPanel.Dock="Top" x:Name="SearchBox" PlaceholderText="Search" Margin="8" TextChanged="OnSearch" />
                <ListBox x:Name="CatList" Classes="settingsCats" Background="Transparent" Padding="0"
                         SelectionChanged="OnCategory" SelectedIndex="0">
                    <ListBoxItem Tag="0">General</ListBoxItem>
                    <ListBoxItem Tag="1">User Interface</ListBoxItem>
                    <ListBoxItem Tag="2">Performance</ListBoxItem>
                    <ListBoxItem Tag="3">Colour</ListBoxItem>
                    <ListBoxItem Tag="4">Machine Learning</ListBoxItem>
                    <ListBoxItem Tag="5">Updates</ListBoxItem>
                    <ListBoxItem Tag="6">Keyboard</ListBoxItem>
                    <ListBoxItem Tag="7">About</ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- right: the selected category's settings -->
        <ScrollViewer Padding="20,14">
            <Panel>
                <!-- General -->
                <StackPanel x:Name="PanelGeneral" Spacing="2">
                    <TextBlock Text="General" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <TextBlock Text="Document" Classes="settingHeader" />
                    <local:SettingRow Label="Reopen documents on startup"><ToggleSwitch x:Name="ReopenSwitch" /></local:SettingRow>
                    <local:SettingRow Label="Limit initial zoom to a maximum of 100%"><ToggleSwitch x:Name="LimitZoomSwitch" /></local:SettingRow>
                    <local:SettingRow Label="Default DPI for new documents"><TextBox Width="80" x:Name="DpiBox" TextAlignment="Center" /></local:SettingRow>
                </StackPanel>

                <!-- User Interface -->
                <StackPanel x:Name="PanelUI" Spacing="2" IsVisible="False">
                    <TextBlock Text="User Interface" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <TextBlock Text="Appearance" Classes="settingHeader" />
                    <local:SettingRow Label="UI style">
                        <ComboBox Width="120" x:Name="ThemeCombo" SelectedIndex="0">
                            <ComboBoxItem>Dark</ComboBoxItem><ComboBoxItem>Gray</ComboBoxItem><ComboBoxItem>Light</ComboBoxItem>
                        </ComboBox>
                    </local:SettingRow>
                    <TextBlock Classes="settingHint" Margin="0,2,0,4"
                               Text="Dark and Gray are complete. Light is in progress (some panels still tune their contrast)." />
                    <TextBlock Text="Canvas overlays" Classes="settingHeader" Margin="0,10,0,0" />
                    <local:SettingRow Label="Guide colour"><local:HexColorField x:Name="GuideColorField" /></local:SettingRow>
                    <local:SettingRow Label="Smart-guide colour"><local:HexColorField x:Name="SmartColorField" /></local:SettingRow>
                    <local:SettingRow Label="Grid colour"><local:HexColorField x:Name="GridColorField" /></local:SettingRow>
                    <local:SettingRow Label="Quick-mask colour"><local:HexColorField x:Name="QuickMaskColorField" /></local:SettingRow>
                    <TextBlock Classes="settingHint" Margin="0,2,0,4"
                               Text="Colours for the on-canvas guides, smart-guide alignment lines, grid, and quick-mask overlay." />
                </StackPanel>

                <!-- Performance -->
                <StackPanel x:Name="PanelPerf" Spacing="2" IsVisible="False">
                    <TextBlock Text="Performance" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <local:SettingRow Label="Undo limit">
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="260">
                            <Slider x:Name="UndoSlider" Width="180" Minimum="16" Maximum="2048" ValueChanged="OnUndoSlider" />
                            <TextBlock x:Name="UndoLabel" Classes="settingLabel" Width="56" Text="256" />
                        </StackPanel>
                    </local:SettingRow>
                    <local:SettingRow Label="Renderer">
                        <TextBlock x:Name="RendererLabel" Classes="settingLabel" Foreground="{DynamicResource ChromeTextDim}" />
                    </local:SettingRow>
                </StackPanel>

                <!-- Colour -->
                <StackPanel x:Name="PanelColor" Spacing="2" IsVisible="False">
                    <TextBlock Text="Colour" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <local:SettingRow Label="Working space">
                        <TextBlock Classes="settingLabel" Foreground="{DynamicResource ChromeTextDim}" Text="Linear RGBA16F" />
                    </local:SettingRow>
                </StackPanel>

                <!-- Machine Learning (placeholder for Phase 8 AI) -->
                <StackPanel x:Name="PanelAI" Spacing="6" IsVisible="False">
                    <TextBlock Text="Machine Learning" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <TextBlock Classes="settingHint"
                               Text="On-device AI models (SAM2 smart-select, background removal, upscale, repair) and the generative Diffusers sidecar are planned (PLAN §6 / Phase 8). The model manager + VRAM gating will live here. Nothing to install yet." />
                </StackPanel>

                <!-- Updates -->
                <StackPanel x:Name="PanelUpdates" Spacing="2" IsVisible="False">
                    <TextBlock Text="Updates" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <local:SettingRow Label="Check for updates on launch"><ToggleSwitch x:Name="AutoUpdateSwitch" /></local:SettingRow>
                </StackPanel>

                <!-- Keyboard (rebindable command hotkeys, PLAN §17.1) -->
                <StackPanel x:Name="PanelKeys" Spacing="2" IsVisible="False">
                    <TextBlock Text="Keyboard" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <TextBlock Classes="settingHint" Margin="0,0,0,6"
                               Text="Click a shortcut, then press the key combination. Backspace clears it; Reset restores the default. Tool letters (B/V/M…) and navigation keys are fixed." />
                    <TextBlock x:Name="KeyWarn" Classes="settingHint" Foreground="{DynamicResource ChromeWarn}" IsVisible="False" Margin="0,0,0,4" />
                    <StackPanel x:Name="KeyRows" Spacing="2" />
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="PanelAbout" Spacing="4" IsVisible="False">
                    <TextBlock Text="Sable" FontSize="18" Foreground="{DynamicResource ChromeText}" />
                    <TextBlock x:Name="VersionLabel" Classes="settingLabel" Foreground="{DynamicResource ChromeTextDim}" />
                    <TextBlock Classes="settingHint" Margin="0,6,0,0"
                               Text="Cross-platform GPU-first raster editor. MIT licence. Third-party notices in THIRD_PARTY_NOTICES.md." />
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </DockPanel>
</Window>
