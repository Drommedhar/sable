<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Sable.App.Localization"
        xmlns:local="clr-namespace:Sable.App"
        x:Class="Sable.App.SettingsWindow"
        Width="780" Height="560"
        Background="{DynamicResource ChromePanel}"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc settingsWindow.settings}">
    <!-- single explicit grid: rows = [content *, footer Auto], cols = [sidebar 190, content *].
         Sidebar spans both rows; the ScrollViewer (row 0) and footer (row 1) tile and never overlap. -->
    <Grid RowDefinitions="*,Auto" ColumnDefinitions="190,*">

        <!-- left: search + category list (full height) -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource ChromeFooter}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <TextBox DockPanel.Dock="Top" x:Name="SearchBox" PlaceholderText="{loc:Loc settingsWindow.search}" Margin="8" TextChanged="OnSearch" />
                <ListBox x:Name="CatList" Classes="settingsCats" Background="Transparent" Padding="0"
                         SelectionChanged="OnCategory" SelectedIndex="0">
                    <ListBoxItem Tag="0">General</ListBoxItem>
                    <ListBoxItem Tag="1">User Interface</ListBoxItem>
                    <ListBoxItem Tag="2">Performance</ListBoxItem>
                    <ListBoxItem Tag="3">Colour</ListBoxItem>
                    <ListBoxItem Tag="4">Machine Learning</ListBoxItem>
                    <ListBoxItem Tag="5">Updates</ListBoxItem>
                    <ListBoxItem Tag="6">Keyboard</ListBoxItem>
                    <ListBoxItem Tag="7">About</ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

            <!-- right: the selected category's settings. StackPanel (not overlapping Panel) is the
                 canonical scrollable content; scrollbar always visible so overflow is obvious. -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="0" Grid.Column="1" ClipToBounds="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- spacing lives on the content (in the scroll extent), not ScrollViewer.Padding (which
                     Avalonia excludes from extent → last row scrolled flush). Right margin clears the
                     floating overlay scrollbar so right-edge controls (Reset) aren't covered. -->
                <StackPanel Margin="20,14,28,20">
                <!-- General -->
                <StackPanel x:Name="PanelGeneral" Spacing="2">
                    <TextBlock Text="{loc:Loc settingsWindow.general}" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:Loc settingsWindow.document}" Classes="settingHeader" />
                    <local:SettingRow Label="Reopen documents on startup"><ToggleSwitch x:Name="ReopenSwitch" /></local:SettingRow>
                    <local:SettingRow Label="Limit initial zoom to a maximum of 100%"><ToggleSwitch x:Name="LimitZoomSwitch" /></local:SettingRow>
                    <local:SettingRow Label="Default DPI for new documents"><TextBox Width="80" x:Name="DpiBox" TextAlignment="Center" /></local:SettingRow>
                </StackPanel>

                <!-- User Interface -->
                <StackPanel x:Name="PanelUI" Spacing="2" IsVisible="False" Margin="0,0,0,24">
                    <TextBlock Text="{loc:Loc settingsWindow.userInterface}" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:Loc settingsWindow.appearance}" Classes="settingHeader" />
                    <local:SettingRow Label="UI style">
                        <ComboBox Width="120" x:Name="ThemeCombo" SelectedIndex="0">
                            <ComboBoxItem>Dark</ComboBoxItem><ComboBoxItem>Gray</ComboBoxItem><ComboBoxItem>Light</ComboBoxItem>
                        </ComboBox>
                    </local:SettingRow>
                    <TextBlock Classes="settingHint" Margin="0,2,0,4"
                               Text="{loc:Loc settingsWindow.darkAndGrayAreComplete}" />
                    <local:SettingRow Label="{loc:Loc settingsWindow.language}">
                        <ComboBox Width="160" x:Name="LanguageCombo" SelectionChanged="OnLanguageChanged" />
                    </local:SettingRow>
                    <TextBlock Classes="settingHint" Margin="0,2,0,4"
                               Text="{loc:Loc settingsWindow.languageHint}" />
                    <TextBlock Text="{loc:Loc settingsWindow.canvasOverlays}" Classes="settingHeader" Margin="0,10,0,0" />
                    <local:SettingRow Label="Guide colour"><local:HexColorField x:Name="GuideColorField" /></local:SettingRow>
                    <local:SettingRow Label="Smart-guide colour"><local:HexColorField x:Name="SmartColorField" /></local:SettingRow>
                    <local:SettingRow Label="Grid colour"><local:HexColorField x:Name="GridColorField" /></local:SettingRow>
                    <local:SettingRow Label="Quick-mask colour"><local:HexColorField x:Name="QuickMaskColorField" /></local:SettingRow>
                    <TextBlock Classes="settingHint" Margin="0,2,0,4"
                               Text="{loc:Loc settingsWindow.coloursForTheOnCanvas}" />
                    <TextBlock Text="{loc:Loc settingsWindow.checkerAndCursor}" Classes="settingHeader" Margin="0,10,0,0" />
                    <local:SettingRow Label="Checker colour A"><local:HexColorField x:Name="CheckerAField" /></local:SettingRow>
                    <local:SettingRow Label="Checker colour B"><local:HexColorField x:Name="CheckerBField" /></local:SettingRow>
                    <local:SettingRow Label="Checker size (px)">
                        <TextBox x:Name="CheckerSizeBox" Width="64" HorizontalContentAlignment="Right" />
                    </local:SettingRow>
                    <local:SettingRow Label="Precise brush cursor (crosshair)">
                        <ToggleSwitch x:Name="PreciseCursorSwitch" />
                    </local:SettingRow>
                    <local:SettingRow Label="{loc:Loc settingsWindow.showWelcomeScreen}">
                        <ToggleSwitch x:Name="WelcomeSwitch" />
                    </local:SettingRow>
                    <local:SettingRow Label="Accent colour"><local:HexColorField x:Name="AccentField" /></local:SettingRow>
                </StackPanel>

                <!-- Performance -->
                <StackPanel x:Name="PanelPerf" Spacing="2" IsVisible="False">
                    <TextBlock Text="{loc:Loc settingsWindow.performance}" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <local:SettingRow Label="Undo limit">
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="260">
                            <Slider x:Name="UndoSlider" Width="180" Minimum="16" Maximum="2048" ValueChanged="OnUndoSlider" />
                            <TextBlock x:Name="UndoLabel" Classes="settingLabel" Width="56" Text="256" />
                        </StackPanel>
                    </local:SettingRow>
                    <local:SettingRow Label="Renderer">
                        <TextBlock x:Name="RendererLabel" Classes="settingLabel" Foreground="{DynamicResource ChromeTextDim}" />
                    </local:SettingRow>
                    <local:SettingRow Label="Autosave for recovery">
                        <ToggleSwitch x:Name="AutosaveSwitch" />
                    </local:SettingRow>
                    <local:SettingRow Label="Autosave interval (min)">
                        <StackPanel Orientation="Horizontal" Spacing="8" Width="260">
                            <Slider x:Name="AutosaveSlider" Width="180" Minimum="1" Maximum="60" ValueChanged="OnAutosaveSlider" />
                            <TextBlock x:Name="AutosaveLabel" Classes="settingLabel" Width="56" Text="5" />
                        </StackPanel>
                    </local:SettingRow>
                    <local:SettingRow Label="Enable plugins (experimental)">
                        <ToggleSwitch x:Name="PluginsSwitch" />
                    </local:SettingRow>
                    <TextBlock Classes="settingHint" Margin="0,2,0,0" Text="{loc:Loc settingsWindow.pluginsHint}" />
                </StackPanel>

                <!-- Colour -->
                <StackPanel x:Name="PanelColor" Spacing="2" IsVisible="False">
                    <TextBlock Text="{loc:Loc settingsWindow.colour}" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <local:SettingRow Label="Working space">
                        <TextBlock Classes="settingLabel" Foreground="{DynamicResource ChromeTextDim}" Text="{loc:Loc settingsWindow.linearRGBA16F}" />
                    </local:SettingRow>
                </StackPanel>

                <!-- Machine Learning (Phase 8 AI) -->
                <StackPanel x:Name="PanelAI" Spacing="2" IsVisible="False" Margin="0,0,0,24">
                    <TextBlock Text="{loc:Loc settingsWindow.machineLearning}" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <local:SettingRow Label="Enable on-device AI"><ToggleSwitch x:Name="AiEnabledSwitch" IsCheckedChanged="OnAiEnabledChanged" /></local:SettingRow>
                    <TextBlock Classes="settingHint" Margin="0,2,0,0"
                               Text="{loc:Loc settingsWindow.gpuOnlyNoCPUFallback}" />
                    <local:SettingRow Label="Generative AI">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border BorderBrush="{DynamicResource ChromeWarn}" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc settingsWindow.experimental}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ChromeWarn}" />
                            </Border>
                            <ToggleSwitch x:Name="GenerativeEnabledSwitch" IsCheckedChanged="OnGenerativeEnabledChanged" />
                        </StackPanel>
                    </local:SettingRow>
                    <TextBlock Classes="settingHint" Margin="0,2,0,0"
                               Text="{loc:Loc settingsWindow.generativeHint}" />

                    <!-- Model sources (ComfyUI reuse) — only when the generative tier is enabled -->
                    <StackPanel x:Name="GenSourcesPanel" Spacing="2" IsVisible="False">
                        <TextBlock Text="{loc:Loc modelsWindow.sources}" Classes="settingHeader" Margin="0,10,0,0" />
                        <TextBlock Classes="settingHint" Text="{loc:Loc modelsWindow.sourcesHint}" TextWrapping="Wrap" />
                        <StackPanel x:Name="GenSourceRows" Spacing="3" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <Button x:Name="AddSourceBtn" Content="{loc:Loc modelsWindow.addComfyUIFolder}" Classes="opt" Padding="14,0" Click="OnAddComfyFolder" />
                            <Button x:Name="CheckSidecarBtn" Content="{loc:Loc modelsWindow.checkSidecar}" Classes="opt" Padding="14,0" Click="OnCheckSidecar" />
                        </StackPanel>
                    </StackPanel>
                    <local:SettingRow Label="Smart Select quality">
                        <ComboBox Width="150" x:Name="SmartSelectCombo" SelectedIndex="0">
                            <ComboBoxItem>Auto (by VRAM)</ComboBoxItem>
                            <ComboBoxItem>Fast</ComboBoxItem>
                            <ComboBoxItem>Balanced</ComboBoxItem>
                            <ComboBoxItem>Thorough</ComboBoxItem>
                        </ComboBox>
                    </local:SettingRow>
                    <TextBlock Classes="settingHint" Margin="0,2,0,0"
                               Text="{loc:Loc settingsWindow.smartSelectQualityHint}" />
                    <StackPanel x:Name="AiModelRows" Spacing="8" Margin="0,10,0,0" IsVisible="False" />
                </StackPanel>

                <!-- Updates -->
                <StackPanel x:Name="PanelUpdates" Spacing="2" IsVisible="False">
                    <TextBlock Text="{loc:Loc settingsWindow.updates}" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <local:SettingRow Label="Check for updates on launch"><ToggleSwitch x:Name="AutoUpdateSwitch" /></local:SettingRow>
                </StackPanel>

                <!-- Keyboard (rebindable command hotkeys, PLAN §17.1) -->
                <StackPanel x:Name="PanelKeys" Spacing="2" IsVisible="False" Margin="0,0,0,24">
                    <TextBlock Text="{loc:Loc settingsWindow.keyboard}" FontSize="16" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,8" />
                    <TextBlock Classes="settingHint" Margin="0,0,0,6"
                               Text="{loc:Loc settingsWindow.clickAShortcutThenPress}" />
                    <local:SettingRow Label="Migration preset">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="KeymapPresetCombo" Width="180" />
                            <Button Content="{loc:Loc settingsWindow.applyPreset}" Classes="opt" Padding="12,0" Click="OnApplyKeymapPreset" />
                        </StackPanel>
                    </local:SettingRow>
                    <TextBlock x:Name="KeyWarn" Classes="settingHint" Foreground="{DynamicResource ChromeWarn}" IsVisible="False" Margin="0,0,0,4" />
                    <StackPanel x:Name="KeyRows" Spacing="2" />
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="PanelAbout" Spacing="4" IsVisible="False">
                    <TextBlock Text="{loc:Loc settingsWindow.sable}" FontSize="18" Foreground="{DynamicResource ChromeText}" />
                    <TextBlock x:Name="VersionLabel" Classes="settingLabel" Foreground="{DynamicResource ChromeTextDim}" />
                    <TextBlock Classes="settingHint" Margin="0,6,0,0"
                               Text="{loc:Loc settingsWindow.crossPlatformGPUFirstRaster}" />
                </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- bottom bar: own row (1), content column (1) — tiles below the ScrollViewer, no overlap -->
            <Border x:Name="FooterBar" Grid.Row="1" Grid.Column="1" Background="{DynamicResource ChromePanel3}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0" Padding="12,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Loc settingsWindow.cancel}" Classes="opt" Padding="16,0" Click="OnCancel" />
                    <Button Content="{loc:Loc settingsWindow.ok}" Classes="opt" Padding="20,0" Click="OnOk" />
                </StackPanel>
            </Border>
    </Grid>
</Window>
