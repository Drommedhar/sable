<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Sable.App.Localization"
        x:Class="Sable.App.UpdateWindow"
        Width="460" SizeToContent="Height" MaxHeight="560"
        Background="{DynamicResource ChromePanel}"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc updateWindow.updateAvailable}">
    <Border Padding="22,18">
        <StackPanel Spacing="8">
            <TextBlock Text="{loc:Loc updateWindow.updateAvailable2}" FontSize="18" Foreground="{DynamicResource ChromeText}" />
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource ChromeTextDim}" />

            <!-- Changelog UI is built in code-behind: one tab per section (Added/Changed/Fixed) and a
                 collapsible expander per version inside each tab. The built-in markdown style is
                 theme-aware but document-sized, so each rendered block is scaled down to chrome density. -->
            <Border x:Name="NotesBox" IsVisible="False" Margin="0,4"
                    Background="{DynamicResource ChromeField}">
                <Panel x:Name="NotesHost" />
            </Border>


            <StackPanel x:Name="ProgressPanel" IsVisible="False" Spacing="4" Margin="0,4">
                <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="6" />
                <TextBlock x:Name="ProgressText" FontSize="11" Foreground="{DynamicResource ChromeTextDim}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" IsVisible="False" FontSize="11" Foreground="#FFE06C6C" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button x:Name="LaterButton" Content="{loc:Loc updateWindow.later}" Classes="opt" Padding="14,0" Click="OnLater" />
                <Button x:Name="DownloadButton" Content="{loc:Loc updateWindow.downloadInstall}" Classes="opt" Padding="14,0" Click="OnDownload" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
