<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Sable.App.Localization"
             xmlns:local="clr-namespace:Sable.App"
             x:Class="Sable.App.ColorPicker">
    <StackPanel Spacing="8">
        <local:ColorWheel x:Name="Wheel" HorizontalAlignment="Center"
                          MaxWidth="{StaticResource ColorWheelMaxSize}" />
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="#" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="12" />
            <TextBox x:Name="HexBox" Width="92" Text="{loc:Loc colorPicker.ffffff}" TextChanged="OnHexChanged" />
            <TextBlock x:Name="Readout" Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>
