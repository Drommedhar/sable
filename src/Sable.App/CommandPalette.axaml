<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sable.App.CommandPalette"
        Width="440" Height="380"
        Background="{DynamicResource ChromePanel}"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None" Title="Commands">
    <Border BorderBrush="{DynamicResource ChromeBorder2}" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Watermark="Run a command…" Margin="8"
                     FontSize="13" TextChanged="OnSearch" KeyDown="OnSearchKey" />
            <ListBox x:Name="ResultList" Margin="8,0,8,8" FontSize="12"
                     Background="Transparent" BorderThickness="0" DoubleTapped="OnRunSelected" />
        </DockPanel>
    </Border>
</Window>
