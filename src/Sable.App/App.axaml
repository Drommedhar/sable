<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sable.App"
             x:Class="Sable.App.App"
             RequestedThemeVariant="Dark">

    <!-- Pro-tool control tuning (PLAN §13.3). All sizing tokens live in Theme.axaml
         (single source of truth); styles below consume them via StaticResource. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Sable.App/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- reusable SettingRow: label left, supplied content right -->
            <ControlTheme x:Key="{x:Type local:SettingRow}" TargetType="local:SettingRow">
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="settingLabel" Text="{TemplateBinding Label}" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- Affinity-style pill toggle switch (bespoke template; Avalonia slides PART_MovingKnobs). -->
            <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border x:Name="track" Width="38" Height="20" CornerRadius="10"
                                Background="{DynamicResource ChromeField}" BorderBrush="{DynamicResource ChromeBorder2}" BorderThickness="1">
                            <Canvas Margin="3,0">
                                <Panel x:Name="PART_MovingKnobs" Canvas.Left="0" Canvas.Top="3" Width="14" Height="14">
                                    <Panel x:Name="PART_SwitchKnob" Width="14" Height="14">
                                        <Ellipse x:Name="knob" Width="14" Height="14" Fill="#FFE6E6E6" />
                                    </Panel>
                                </Panel>
                            </Canvas>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:checked /template/ Border#track">
                    <Setter Property="Background" Value="#FF3A6EA5" />
                    <Setter Property="BorderBrush" Value="#FF3A6EA5" />
                </Style>
                <Style Selector="^:checked /template/ Ellipse#knob">
                    <Setter Property="Fill" Value="White" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#track">
                    <Setter Property="BorderBrush" Value="#FF7A7A7A" />
                </Style>
            </ControlTheme>

            <!-- Compact dark checkbox (Affinity-size box). Bespoke template so the box size
                 is driven by CheckBoxBoxSize and doesn't depend on Fluent's part names. -->
            <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource ChromeText}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border x:Name="box" Grid.Column="0"
                                    Width="{StaticResource CheckBoxBoxSize}" Height="{StaticResource CheckBoxBoxSize}"
                                    CornerRadius="3" Background="{DynamicResource ChromeField}"
                                    BorderBrush="{DynamicResource ChromeBorder2}" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="tick" Stretch="Uniform" Margin="2.5"
                                      Stroke="White" StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M2 6 L5 9 L10 2" IsVisible="False" />
                            </Border>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                                              Margin="6,0,0,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:checked /template/ Path#tick">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:checked /template/ Border#box">
                    <Setter Property="Background" Value="#FF3A6EA5" />
                    <Setter Property="BorderBrush" Value="#FF3A6EA5" />
                </Style>
                <Style Selector="^:indeterminate /template/ Path#tick">
                    <Setter Property="IsVisible" Value="True" />
                    <Setter Property="Data" Value="M2 6 H10" />
                </Style>
                <Style Selector="^:indeterminate /template/ Border#box">
                    <Setter Property="Background" Value="#FF3A6EA5" />
                    <Setter Property="BorderBrush" Value="#FF3A6EA5" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#box">
                    <Setter Property="BorderBrush" Value="#FF7A7A7A" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.5" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <!-- Sable dark chrome: dense, pro-tool styling (PLAN §13.3). -->
        <Style Selector="Menu">
            <Setter Property="Background" Value="{DynamicResource ChromeMenuBg}" />
            <Setter Property="Height" Value="{StaticResource MenuBarHeight}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ChromeText}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        </Style>
        <Style Selector="TextBlock.panelHeader">
            <Setter Property="Foreground" Value="{DynamicResource ChromeTextDim}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector=":is(Button).tool">
            <Setter Property="Width" Value="{StaticResource ToolButtonSize}" />
            <Setter Property="Height" Value="{StaticResource ToolButtonSize}" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeText}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector=":is(Button).tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3A3A3A" />
        </Style>
        <!-- ToolButton glyph size comes from the theme token (single source of truth) -->
        <Style Selector="local|ToolButton">
            <Setter Property="IconSize" Value="{StaticResource ToolIconSize}" />
        </Style>

        <!-- Lucide-style monochrome line icons (project icon system, PLAN §13.3 / no-emoji rule) -->
        <Style Selector="Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource ChromeText}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <!-- window caption buttons (custom title bar: minimise / maximise / close) -->
        <Style Selector="Button.winbtn">
            <Setter Property="Width" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeText}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.winbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3A3A3A" />
        </Style>
        <Style Selector="Button.winclose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFC42B1C" />
        </Style>

        <!-- compact icon button for the layers-panel footer -->
        <Style Selector="Button.iconbtn">
            <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
            <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3A3A3A" />
        </Style>

        <!-- borderless visibility (eye) toggle on the right of each layer row -->
        <Style Selector="ToggleButton.eye">
            <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
            <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="ToggleButton.eye:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.eye:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3A3A3A" />
        </Style>

        <!-- dense, Affinity-style layer rows: tight padding + blue selection bar -->
        <Style Selector="ListBox.layers > ListBoxItem">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBox.layers > ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF2E2E2E" />
        </Style>
        <Style Selector="ListBox.layers > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF2D5A88" />
        </Style>
        <Style Selector="ListBox.layers > ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF356699" />
        </Style>

        <!-- ===== unified chrome controls: 24px tall, dark #2b2b2b, blue #5687C0 accent ===== -->

        <!-- slider: stock Fluent Track (reliable) + small custom thumb. Fluent reserves height below
             the track, so a -12 top margin lifts the thumb centre onto the row-text centre
             (pixel-measured: thumb c=63.5 == text c=63.5; re-measure before changing). -->
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-12,0,0" />
        </Style>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Ellipse Width="14" Height="14" Fill="#FFE6E6E6" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- compact dark combo box -->
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource ChromeField}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeText}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ChromeField}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
        </Style>

        <!-- compact dark text box + numeric up/down (share the same field look) -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource ChromeField}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeText}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource ChromeField}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeText}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ShowButtonSpinner" Value="False" />
        </Style>
        <!-- belt + suspenders: hide the spinner button area outright -->
        <Style Selector="NumericUpDown /template/ ButtonSpinner">
            <Setter Property="ShowButtonSpinner" Value="False" />
        </Style>

        <!-- compact options-bar toggle (B / I / U / S / alignment) -->
        <Style Selector="ToggleButton.opt">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Background" Value="{DynamicResource ChromeField}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeText}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.opt:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3A3A3A" />
        </Style>
        <Style Selector="ToggleButton.opt:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3A6EA5" />
        </Style>

        <!-- adjustment-panel slider label (Affinity) -->
        <Style Selector="TextBlock.adjLabel">
            <Setter Property="Foreground" Value="{DynamicResource ChromeTextDim}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        </Style>
        <!-- Settings dialog: section header + setting-row label -->
        <Style Selector="TextBlock.settingHeader">
            <Setter Property="Foreground" Value="{DynamicResource ChromeText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style Selector="TextBlock.settingLabel">
            <Setter Property="Foreground" Value="{DynamicResource ChromeText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.settingHint">
            <Setter Property="Foreground" Value="{DynamicResource ChromeTextFaint}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ListBox.settingsCats > ListBoxItem">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ListBox.settingsCats > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF2D5A88" />
        </Style>

        <!-- dense rows for the Layer Effects master list -->
        <Style Selector="ListBox#FxList > ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- right-aligned form label (Layer Effects dialog) -->
        <Style Selector="TextBlock.fxLabel">
            <Setter Property="Foreground" Value="{DynamicResource ChromeTextDim}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- compact checkbox: a bespoke ControlTheme drives the box size (Theme.axaml token),
             version-proof vs Fluent's internal template part names. -->
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        </Style>
    </Application.Styles>
</Application>
