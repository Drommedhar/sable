<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sable.App.App"
             RequestedThemeVariant="Dark">

    <!-- Pro-tool control tuning (PLAN §13.3). All sizing tokens live in Theme.axaml
         (single source of truth); styles below consume them via StaticResource. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Sable.App/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Compact dark checkbox (Affinity-size box). Bespoke template so the box size
                 is driven by CheckBoxBoxSize and doesn't depend on Fluent's part names. -->
            <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
                <Setter Property="Foreground" Value="#FFDDDDDD" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border x:Name="box" Grid.Column="0"
                                    Width="{StaticResource CheckBoxBoxSize}" Height="{StaticResource CheckBoxBoxSize}"
                                    CornerRadius="3" Background="#FF2B2B2B"
                                    BorderBrush="#FF5A5A5A" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="tick" Stretch="Uniform" Margin="2.5"
                                      Stroke="White" StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M2 6 L5 9 L10 2" IsVisible="False" />
                            </Border>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                                              Margin="6,0,0,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:checked /template/ Path#tick">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:checked /template/ Border#box">
                    <Setter Property="Background" Value="#FF3A6EA5" />
                    <Setter Property="BorderBrush" Value="#FF3A6EA5" />
                </Style>
                <Style Selector="^:indeterminate /template/ Path#tick">
                    <Setter Property="IsVisible" Value="True" />
                    <Setter Property="Data" Value="M2 6 H10" />
                </Style>
                <Style Selector="^:indeterminate /template/ Border#box">
                    <Setter Property="Background" Value="#FF3A6EA5" />
                    <Setter Property="BorderBrush" Value="#FF3A6EA5" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#box">
                    <Setter Property="BorderBrush" Value="#FF7A7A7A" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.5" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <!-- Sable dark chrome: dense, pro-tool styling (PLAN §13.3). -->
        <Style Selector="Menu">
            <Setter Property="Background" Value="#FF2D2D2D" />
            <Setter Property="Height" Value="{StaticResource MenuBarHeight}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="#FFCCCCCC" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        </Style>
        <Style Selector="TextBlock.panelHeader">
            <Setter Property="Foreground" Value="#FFAAAAAA" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Width" Value="{StaticResource ToolButtonSize}" />
            <Setter Property="Height" Value="{StaticResource ToolButtonSize}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFCFCFCF" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3A3A3A" />
        </Style>

        <!-- Lucide-style monochrome line icons (project icon system, PLAN §13.3 / no-emoji rule) -->
        <Style Selector="Path.icon">
            <Setter Property="Stroke" Value="#FFCFCFCF" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <!-- compact icon button for the layers-panel footer -->
        <Style Selector="Button.iconbtn">
            <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
            <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3A3A3A" />
        </Style>

        <!-- borderless visibility (eye) toggle on the right of each layer row -->
        <Style Selector="ToggleButton.eye">
            <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
            <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="ToggleButton.eye:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.eye:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3A3A3A" />
        </Style>

        <!-- dense, Affinity-style layer rows: tight padding + blue selection bar -->
        <Style Selector="ListBox.layers > ListBoxItem">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBox.layers > ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF2E2E2E" />
        </Style>
        <Style Selector="ListBox.layers > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF2D5A88" />
        </Style>
        <Style Selector="ListBox.layers > ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF356699" />
        </Style>

        <!-- ===== unified chrome controls: 24px tall, dark #2b2b2b, blue #5687C0 accent ===== -->

        <!-- slider: stock Fluent Track (reliable), but a small custom thumb so it doesn't clip.
             Negative top margin pulls the track up to vertically centre with the row text. -->
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-4,0,0" />
        </Style>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Ellipse Width="14" Height="14" Fill="#FFE6E6E6" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- compact dark combo box -->
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#FF2B2B2B" />
            <Setter Property="BorderBrush" Value="#FF3C3C3C" />
            <Setter Property="Foreground" Value="#FFDDDDDD" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="#FF2B2B2B" />
            <Setter Property="BorderBrush" Value="#FF3C3C3C" />
        </Style>

        <!-- compact dark text box + numeric up/down (share the same field look) -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#FF2B2B2B" />
            <Setter Property="BorderBrush" Value="#FF3C3C3C" />
            <Setter Property="Foreground" Value="#FFDDDDDD" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#FF2B2B2B" />
            <Setter Property="BorderBrush" Value="#FF3C3C3C" />
            <Setter Property="Foreground" Value="#FFDDDDDD" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ShowButtonSpinner" Value="False" />
        </Style>
        <!-- belt + suspenders: hide the spinner button area outright -->
        <Style Selector="NumericUpDown /template/ ButtonSpinner">
            <Setter Property="ShowButtonSpinner" Value="False" />
        </Style>

        <!-- compact options-bar toggle (B / I / U / S / alignment) -->
        <Style Selector="ToggleButton.opt">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Background" Value="#FF2F2F2F" />
            <Setter Property="BorderBrush" Value="#FF3C3C3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFDDDDDD" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.opt:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3A3A3A" />
        </Style>
        <Style Selector="ToggleButton.opt:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3A6EA5" />
        </Style>

        <!-- adjustment-panel slider label (Affinity) -->
        <Style Selector="TextBlock.adjLabel">
            <Setter Property="Foreground" Value="#FFAAAAAA" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        </Style>
        <!-- dense rows for the Layer Effects master list -->
        <Style Selector="ListBox#FxList > ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- right-aligned form label (Layer Effects dialog) -->
        <Style Selector="TextBlock.fxLabel">
            <Setter Property="Foreground" Value="#FFAAAAAA" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- compact checkbox: a bespoke ControlTheme drives the box size (Theme.axaml token),
             version-proof vs Fluent's internal template part names. -->
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        </Style>
    </Application.Styles>
</Application>
