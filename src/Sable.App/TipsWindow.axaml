<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Sable.App.Localization"
        x:Class="Sable.App.TipsWindow"
        Width="440" SizeToContent="Height"
        Background="{DynamicResource ChromePanel}"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc tipsWindow.title}">
    <Border Padding="20">
        <StackPanel Spacing="10">
            <TextBlock Text="{loc:Loc tipsWindow.heading}" Classes="panelHeader" Padding="0" FontSize="15" />
            <TextBlock Text="{loc:Loc tipsWindow.tipTools}" Foreground="{DynamicResource ChromeText}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Loc tipsWindow.tipCanvas}" Foreground="{DynamicResource ChromeText}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Loc tipsWindow.tipLayers}" Foreground="{DynamicResource ChromeText}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Loc tipsWindow.tipNonDestructive}" Foreground="{DynamicResource ChromeText}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Loc tipsWindow.tipShortcuts}" Foreground="{DynamicResource ChromeText}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Loc tipsWindow.tipAi}" Foreground="{DynamicResource ChromeTextDim}" FontSize="12" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Content="{loc:Loc tipsWindow.close}" Classes="opt" Padding="16,2" Click="OnClose" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
