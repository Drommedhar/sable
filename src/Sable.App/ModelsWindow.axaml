<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Sable.App.Localization"
        x:Class="Sable.App.ModelsWindow"
        Width="720" Height="620"
        Background="{DynamicResource ChromePanel}"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc modelsWindow.models}">
    <DockPanel>
        <!-- footer: model folder + close -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeFooter}" Padding="14,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="FolderLabel" Classes="settingHint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="{loc:Loc modelsWindow.close}" Classes="opt" Padding="18,0" Click="OnClose" />
            </Grid>
        </Border>

        <TabControl Margin="8,6,8,0">
            <!-- ONNX (light tier): in-process ONNX Runtime models -->
            <TabItem Header="{loc:Loc modelsWindow.onnxTab}">
                <DockPanel Margin="6,10,6,6">
                    <StackPanel DockPanel.Dock="Top" Spacing="6">
                        <Button x:Name="DownloadSetBtn" Content="{loc:Loc modelsWindow.downloadRecommendedSetLightAI}"
                                Classes="opt" HorizontalAlignment="Left" Padding="14,0" Click="OnDownloadSet" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="UrlBox" PlaceholderText="{loc:Loc modelsWindow.directURLOrHuggingFaceOwner}" />
                            <Button Grid.Column="1" Content="{loc:Loc modelsWindow.download}" Classes="opt"
                                    Padding="14,0" Margin="6,0,0,0" Click="OnDownloadUrl" />
                        </Grid>
                        <TextBlock x:Name="Status" Classes="settingHint" Foreground="{DynamicResource ChromeWarn}"
                                   IsVisible="False" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel x:Name="OnnxCards" Spacing="8" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Generative (sidecar tier): placeholder until the Diffusers sidecar ships -->
            <TabItem Header="{loc:Loc modelsWindow.generativeTab}">
                <StackPanel Margin="24" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc modelsWindow.generativeTitle}" FontSize="16"
                               Foreground="{DynamicResource ChromeText}" HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:Loc modelsWindow.generativeBody}" Classes="settingHint"
                               MaxWidth="430" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
