<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Sable.App.Localization"
        x:Class="Sable.App.ResizeCanvasWindow"
        Width="360" Height="280" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ChromePanel}"
        Title="{loc:Loc resizeCanvasWindow.resizeCanvas}">
    <StackPanel Margin="16" Spacing="12">

        <Grid ColumnDefinitions="64,*,30,*" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="{loc:Loc resizeCanvasWindow.size}" Foreground="{DynamicResource ChromeText}" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" x:Name="WBox" Minimum="1" Maximum="32768" Increment="1"
                           FormatString="0" ValueChanged="OnSizeChanged" />
            <TextBlock Grid.Column="2" Text="×" Foreground="{DynamicResource ChromeTextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="3" x:Name="HBox" Minimum="1" Maximum="32768" Increment="1"
                           FormatString="0" ValueChanged="OnSizeChanged" />
        </Grid>

        <Grid ColumnDefinitions="64,*" VerticalAlignment="Top">
            <TextBlock Grid.Column="0" Text="{loc:Loc resizeCanvasWindow.anchor}" Foreground="{DynamicResource ChromeText}" VerticalAlignment="Center" />
            <UniformGrid Grid.Column="1" x:Name="AnchorGrid" Rows="3" Columns="3"
                         Width="84" Height="84" HorizontalAlignment="Left" />
        </Grid>

        <TextBlock x:Name="DescText" Foreground="{DynamicResource ChromeTextDim}" FontSize="11" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc resizeCanvasWindow.resize}" Click="OnResize" Width="80" />
            <Button Content="{loc:Loc resizeCanvasWindow.cancel}" Click="OnCancel" Width="80" />
        </StackPanel>
    </StackPanel>
</Window>
