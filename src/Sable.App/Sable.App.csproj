<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\..\img\sable.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- brand assets (logo + icon) compiled into the app at avares://Sable.App/Assets/* -->
  <ItemGroup>
    <AvaloniaResource Include="..\..\img\logo_only.png" Link="Assets/logo_only.png" />
    <AvaloniaResource Include="..\..\img\sable.ico" Link="Assets/sable.ico" />
  </ItemGroup>

  <!-- locale JSON read from disk at runtime (Loc.Initialize -> {BaseDir}/Assets/Locales) -->
  <ItemGroup>
    <Content Include="Assets\Locales\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- the generative sidecar's Python server, run from {BaseDir}/server (a ProjectReference does not
       flow the referenced project's content into this output, so copy it here too). -->
  <ItemGroup>
    <None Include="..\Sable.Ai.Sidecar\server\**\*.py" CopyToOutputDirectory="PreserveNewest" LinkBase="server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.0-a3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sable.UI\Sable.UI.csproj" />
    <ProjectReference Include="..\Sable.Canvas\Sable.Canvas.csproj" />
    <ProjectReference Include="..\Sable.Engine\Sable.Engine.csproj" />
    <ProjectReference Include="..\Sable.Ai\Sable.Ai.csproj" />
    <ProjectReference Include="..\Sable.Ai.Sidecar\Sable.Ai.Sidecar.csproj" />
    <ProjectReference Include="..\Sable.Ai.Comfy\Sable.Ai.Comfy.csproj" />
    <ProjectReference Include="..\Sable.Format\Sable.Format.csproj" />
    <ProjectReference Include="..\Sable.Plugin.Sdk\Sable.Plugin.Sdk.csproj" />
    <ProjectReference Include="..\Sable.Plugins\Sable.Plugins.csproj" />
    <ProjectReference Include="..\Sable.Plugins.Engine\Sable.Plugins.Engine.csproj" />
  </ItemGroup>

  <!-- i18n gate: fail the build on missing keys / unlocalized literals (docs/i18n-decision.md).
       Exit 1 = drift -> build error. python not found -> warn + continue (don't block python-less devs).
       Skipped during design-time/IDE intellisense builds. -->
  <Target Name="LocaleDoctor" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingForLiveUnitTesting)' != 'true'">
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\tools\locale-doctor.py&quot; --strict" ContinueOnError="true" StandardOutputImportance="high" StandardErrorImportance="high">
      <Output TaskParameter="ExitCode" PropertyName="_LocaleDoctorExit" />
    </Exec>
    <Warning Condition="'$(_LocaleDoctorExit)' != '0' and '$(_LocaleDoctorExit)' != '1'" Text="locale-doctor skipped: python not found (exit $(_LocaleDoctorExit)). i18n is not being checked on this machine." />
    <Error Condition="'$(_LocaleDoctorExit)' == '1'" Text="locale-doctor found i18n problems (missing keys or unlocalized .axaml strings). Run: python tools/locale-doctor.py --list-literals" />
  </Target>
</Project>
