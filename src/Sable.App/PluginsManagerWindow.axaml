<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Sable.App.Localization"
        x:Class="Sable.App.PluginsManagerWindow"
        Width="540" Height="560"
        Background="{DynamicResource ChromePanel}"
        CanResize="True" ShowInTaskbar="False"
        Title="{loc:Loc pluginManager.title}">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeHeaderBg}" Padding="12,8">
            <StackPanel Spacing="2">
                <TextBlock Text="{loc:Loc pluginManager.title}" Foreground="{DynamicResource ChromeText}" FontWeight="SemiBold" />
                <TextBlock x:Name="DirLabel" Foreground="{DynamicResource ChromeTextFaint}" FontSize="11" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeFooter}" Padding="10,7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc pluginManager.reload}" Classes="opt" Padding="14,0" Click="OnReload" />
                <Button Content="{loc:Loc pluginManager.close}" Classes="opt" Padding="14,0" Click="OnClose" />
            </StackPanel>
        </Border>

        <Grid RowDefinitions="*,Auto,140">
            <ScrollViewer Grid.Row="0" Padding="12" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PluginRows" Spacing="8" />
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="{loc:Loc pluginManager.log}" Margin="12,4" FontSize="11"
                       Foreground="{DynamicResource ChromeTextFaint}" />
            <Border Grid.Row="2" Margin="12,0,12,8" Background="{DynamicResource ChromeCanvas}"
                    BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1" CornerRadius="3">
                <ScrollViewer Padding="8">
                    <TextBlock x:Name="LogText" FontSize="11" FontFamily="Consolas,monospace"
                               Foreground="{DynamicResource ChromeTextFaint}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
