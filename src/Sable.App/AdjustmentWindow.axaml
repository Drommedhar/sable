<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Sable.App.Localization"
        xmlns:vm="clr-namespace:Sable.UI.ViewModels;assembly=Sable.UI"
        xmlns:local="clr-namespace:Sable.App"
        x:Class="Sable.App.AdjustmentWindow"
        x:DataType="vm:DocumentViewModel"
        Width="300" Height="440"
        Background="{DynamicResource ChromePanel}"
        CanResize="True"
        ShowInTaskbar="False"
        Title="{loc:Loc adjustmentWindow.adjustment}">

    <!-- thin floating wrapper; the editor itself lives in the reusable AdjustmentPanel
         (also embedded in the right panel) so there is a single source of truth. -->
    <local:AdjustmentPanel x:Name="Panel" />
</Window>
