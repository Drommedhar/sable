<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:canvas="clr-namespace:Sable.Canvas;assembly=Sable.Canvas"
        xmlns:vm="clr-namespace:Sable.UI.ViewModels;assembly=Sable.UI"
        xmlns:eng="clr-namespace:Sable.Engine.Layers;assembly=Sable.Engine"
        xmlns:ac="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        xmlns:local="clr-namespace:Sable.App"
        xmlns:loc="clr-namespace:Sable.App.Localization"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="Sable.App.MainWindow"
        x:DataType="vm:DocumentViewModel"
        Width="1280" Height="760"
        Background="{DynamicResource ChromeWindowBg}"
        Icon="avares://Sable.App/Assets/sable.ico"
        Title="{loc:Loc mainWindow.sable}">

    <Window.KeyBindings>
        <!-- Ctrl+Z / Ctrl+Y come from the rebindable keymap (PLAN §17.1); Shift+Z stays a fixed redo alt -->
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoEditCommand}" />
    </Window.KeyBindings>

    <!-- PS/Affinity-style chrome skeleton (PLAN §13). Real dockable panels (Dock.Avalonia)
         and the embedded wgpu canvas surface land in later milestones. -->
    <Panel>
    <!-- OffScreenMargin keeps the custom title bar from clipping when maximised -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">

        <!-- (4) Title bar = brand logo + menu + window buttons (custom client-side decorations) -->
        <DockPanel Grid.Row="0" Background="{DynamicResource ChromeMenuBg}">
        <Image DockPanel.Dock="Left" Source="avares://Sable.App/Assets/logo_only.png"
               Height="18" Stretch="Uniform" Margin="12,5,12,5" VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               ToolTip.Tip="{loc:Loc mainWindow.sable}" />
        <!-- window caption buttons (right). Driven off PointerReleased (OnCaptionReleased), NOT Click:
             in the custom BorderOnly title bar the Avalonia Click gesture is unreliable for these top-row
             buttons (press+release reach the button but Click never fires until the window deactivates —
             diagnosed via diag.log). PointerPressed/Released fire 100% of the time, so we act on release. -->
        <StackPanel x:Name="CaptionButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Stretch">
            <Button Classes="winbtn" Tag="min" ToolTip.Tip="{loc:Loc mainWindow.minimise}">
                <Border Width="11" Height="1.5" Background="{DynamicResource ChromeText}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="MaxRestoreBtn" Classes="winbtn" Tag="max" ToolTip.Tip="{loc:Loc mainWindow.maximise}">
                <Path Classes="icon" Width="10" Height="10" Data="M4 4h16v16H4z" />
            </Button>
            <Button Classes="winbtn winclose" Tag="close" ToolTip.Tip="{loc:Loc mainWindow.close}">
                <Path Classes="icon" Width="11" Height="11" Data="M5 5l14 14 M19 5l-14 14" />
            </Button>
        </StackPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Left">
            <MenuItem Header="{loc:Loc menu.file}">
                <MenuItem Header="{loc:Loc menu.file.new}" Click="OnNewMenu" InputGesture="Ctrl+N" Tag="file.new" />
                <MenuItem Header="{loc:Loc menu.file.newFromClipboard}" Click="OnNewFromClipboard" />
                <Separator />
                <MenuItem Header="{loc:Loc menu.file.open}" Click="OnOpenSable" InputGesture="Ctrl+O" Tag="file.open" />
                <MenuItem Header="{loc:Loc menu.file.openImage}" Click="OnOpenImage" Tag="file.openImage" />
                <MenuItem x:Name="FilePlaceItem" Header="{loc:Loc menu.file.place}" Click="OnPlaceImage" />
                <MenuItem Header="{loc:Loc menu.file.openRecent}" x:Name="RecentMenu" />
                <Separator />
                <MenuItem x:Name="FileSaveItem" Header="{loc:Loc menu.file.save}" Click="OnSaveSable" InputGesture="Ctrl+S" Tag="file.save" />
                <MenuItem x:Name="FileSaveAsItem" Header="{loc:Loc menu.file.saveAs}" Click="OnSaveAsSable" Tag="file.saveAs" />
                <MenuItem x:Name="FileRevertItem" Header="{loc:Loc menu.file.revert}" Click="OnRevert" />
                <Separator />
                <MenuItem x:Name="FileCloseItem" Header="{loc:Loc menu.file.close}" Click="OnCloseActive" InputGesture="Ctrl+W" Tag="file.closeTab" />
                <MenuItem x:Name="FileCloseAllItem" Header="{loc:Loc menu.file.closeAll}" Click="OnCloseAll" />
                <MenuItem x:Name="FileCloseOthersItem" Header="{loc:Loc menu.file.closeOthers}" Click="OnCloseOthers" />
                <Separator />
                <MenuItem x:Name="FileExportItem" Header="{loc:Loc menu.file.export}" Click="OnExport" />
            </MenuItem>
            <MenuItem Header="{loc:Loc menu.edit}">
                <MenuItem Header="{loc:Loc menu.edit.undo}" Command="{Binding UndoEditCommand}" InputGesture="Ctrl+Z" Tag="edit.undo" />
                <MenuItem Header="{loc:Loc menu.edit.redo}" Command="{Binding RedoEditCommand}" InputGesture="Ctrl+Y" Tag="edit.redo" />
                <Separator />
                <MenuItem x:Name="EditCutItem" Header="{loc:Loc menu.edit.cut}" Click="OnCut" InputGesture="Ctrl+X" Tag="edit.cut" />
                <MenuItem x:Name="EditCopyItem" Header="{loc:Loc menu.edit.copy}" Click="OnCopy" InputGesture="Ctrl+C" Tag="edit.copy" />
                <MenuItem x:Name="EditCopyMergedItem" Header="{loc:Loc menu.edit.copyMerged}" Click="OnCopyMerged" InputGesture="Ctrl+Shift+C" Tag="edit.copyMerged" />
                <MenuItem x:Name="EditPasteItem" Header="{loc:Loc menu.edit.paste}" Click="OnPaste" InputGesture="Ctrl+V" Tag="edit.paste" />
                <MenuItem x:Name="EditPasteIntoItem" Header="{loc:Loc menu.edit.pasteInto}" Click="OnPasteInto" InputGesture="Ctrl+Shift+V" Tag="edit.pasteInto" />
                <MenuItem x:Name="EditPasteInPlaceItem" Header="{loc:Loc menu.edit.pasteInPlace}" Click="OnPasteInPlace" InputGesture="Ctrl+Alt+V" Tag="edit.pasteInPlace" />
                <MenuItem x:Name="EditDuplicateItem" Header="{loc:Loc menu.edit.duplicateLayer}" Click="OnDuplicate" InputGesture="Ctrl+J" Tag="edit.duplicate" />
                <Separator />
                <MenuItem x:Name="EditFillFgItem" Header="{loc:Loc menu.edit.fillForeground}" Click="OnFillForeground" InputGesture="Alt+Back" Tag="edit.fillFg" />
                <MenuItem x:Name="EditFillBgItem" Header="{loc:Loc menu.edit.fillBackground}" Click="OnFillBackground" InputGesture="Ctrl+Back" Tag="edit.fillBg" />
                <Separator />
                <MenuItem Header="{loc:Loc menu.edit.preferences}" Click="OnPreferences" />
            </MenuItem>
            <MenuItem x:Name="ImageMenu" Header="{loc:Loc menu.image}">
                <MenuItem Header="{loc:Loc menu.image.mode}">
                    <MenuItem x:Name="Depth8Item" Header="{loc:Loc menu.image.depth8}" ToggleType="Radio" GroupName="depth" Click="OnSetDepth8" />
                    <MenuItem x:Name="Depth16Item" Header="{loc:Loc menu.image.depth16}" ToggleType="Radio" GroupName="depth" Click="OnSetDepth16" />
                    <MenuItem x:Name="Depth32Item" Header="{loc:Loc menu.image.depth32}" ToggleType="Radio" GroupName="depth" Click="OnSetDepth32" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{loc:Loc menu.image.resizeDocument}" Click="OnResizeDocument" />
                <MenuItem Header="{loc:Loc menu.image.resizeCanvas}" Click="OnResizeCanvas" />
            </MenuItem>
            <MenuItem x:Name="LayerMenu" Header="{loc:Loc mainWindow.layer}">
                <MenuItem Header="{loc:Loc mainWindow.duplicate}" Click="OnDuplicate" InputGesture="Ctrl+J" Tag="edit.duplicate" />
                <MenuItem Header="{loc:Loc mainWindow.rasterise}" Click="OnRasterise" />
                <Separator />
                <MenuItem Header="{loc:Loc mainWindow.groupSelected}" Command="{Binding GroupCommand}" InputGesture="Ctrl+G" Tag="layer.group" />
                <MenuItem Header="{loc:Loc mainWindow.ungroup}" Command="{Binding UngroupCommand}" InputGesture="Ctrl+Shift+G" Tag="layer.ungroup" />
                <Separator />
                <MenuItem Header="{loc:Loc mainWindow.mergeDown}" Click="OnMergeDown" InputGesture="Ctrl+E" Tag="layer.mergeDown" />
                <MenuItem Header="{loc:Loc mainWindow.mergeVisible}" Click="OnMergeVisible" InputGesture="Ctrl+Shift+E" Tag="layer.mergeVisible" />
                <MenuItem Header="{loc:Loc mainWindow.stampVisible}" Click="OnStamp" InputGesture="Ctrl+Shift+Alt+E" Tag="layer.stamp" />
                <MenuItem Header="{loc:Loc mainWindow.flattenImage}" Click="OnFlatten" />
                <Separator />
                <MenuItem Header="{loc:Loc mainWindow.transform}">
                    <MenuItem Header="{loc:Loc mainWindow.flipHorizontal}" Click="OnFlipH" />
                    <MenuItem Header="{loc:Loc mainWindow.flipVertical}" Click="OnFlipV" />
                    <Separator />
                    <MenuItem Header="{loc:Loc mainWindow.rotate90CW}" Click="OnRotate90CW" />
                    <MenuItem Header="{loc:Loc mainWindow.rotate90CCW}" Click="OnRotate90CCW" />
                    <MenuItem Header="{loc:Loc mainWindow.rotate180}" Click="OnRotate180" />
                    <Separator />
                    <MenuItem Header="{loc:Loc mainWindow.resetTransform}" Click="OnResetTransform" />
                </MenuItem>
                <MenuItem Header="{loc:Loc mainWindow.align}">
                    <MenuItem Header="{loc:Loc mainWindow.alignLeft}" Click="OnAlignLeft" />
                    <MenuItem Header="{loc:Loc mainWindow.alignCenter}" Click="OnAlignCenterH" />
                    <MenuItem Header="{loc:Loc mainWindow.alignRight}" Click="OnAlignRight" />
                    <Separator />
                    <MenuItem Header="{loc:Loc mainWindow.alignTop}" Click="OnAlignTop" />
                    <MenuItem Header="{loc:Loc mainWindow.alignMiddle}" Click="OnAlignMiddle" />
                    <MenuItem Header="{loc:Loc mainWindow.alignBottom}" Click="OnAlignBottom" />
                    <Separator />
                    <MenuItem Header="{loc:Loc mainWindow.distributeHorizontally}" Click="OnDistributeH" />
                    <MenuItem Header="{loc:Loc mainWindow.distributeVertically}" Click="OnDistributeV" />
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="TypeMenu" Header="{loc:Loc mainWindow.type}">
                <MenuItem Header="{loc:Loc mainWindow.convertToCurves}" Click="OnTextToCurves" />
                <Separator />
                <MenuItem Header="{loc:Loc mainWindow.fitTextToPath}" Click="OnTextToPath" />
                <MenuItem Header="{loc:Loc mainWindow.detachTextFromPath}" Click="OnTextDetachPath" />
            </MenuItem>
            <MenuItem x:Name="SelectMenu" Header="{loc:Loc mainWindow.select}">
                <MenuItem Header="{loc:Loc mainWindow.selectAll}" Click="OnSelectAll" InputGesture="Ctrl+A" Tag="select.all" />
                <MenuItem Header="{loc:Loc mainWindow.deselect}" Click="OnDeselect" InputGesture="Ctrl+D" Tag="select.deselect" />
                <MenuItem Header="{loc:Loc mainWindow.invert}" Click="OnInvertSelection" InputGesture="Ctrl+Shift+I" Tag="select.invert" />
                <Separator />
                <MenuItem Header="{loc:Loc mainWindow.growSel}" Click="OnGrowSelection" />
                <MenuItem Header="{loc:Loc mainWindow.shrinkSel}" Click="OnShrinkSelection" />
                <MenuItem Header="{loc:Loc mainWindow.smoothSel}" Click="OnSmoothSelection" />
                <MenuItem Header="{loc:Loc mainWindow.borderSel}" Click="OnBorderSelection" />
                <MenuItem Header="{loc:Loc mainWindow.featherSel}" Click="OnFeatherSelection" />
                <Separator />
                <MenuItem Header="{loc:Loc mainWindow.saveSelection}" Click="OnSaveSelection" />
                <MenuItem Header="{loc:Loc mainWindow.loadSelection}" Click="OnLoadSelection" />
            </MenuItem>
            <MenuItem x:Name="FilterMenu" Header="{loc:Loc mainWindow.filter}">
                <MenuItem Header="{loc:Loc mainWindow.gaussianBlur}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.GaussianBlur}" />
                <MenuItem Header="{loc:Loc mainWindow.boxBlur}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.BoxBlur}" />
                <MenuItem Header="{loc:Loc mainWindow.motionBlur}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.MotionBlur}" />
                <MenuItem Header="{loc:Loc mainWindow.zoomBlur}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.ZoomBlur}" />
                <Separator />
                <MenuItem Header="{loc:Loc mainWindow.sharpen}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.Sharpen}" />
                <MenuItem Header="{loc:Loc mainWindow.unsharpMask}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.UnsharpMask}" />
                <MenuItem Header="{loc:Loc mainWindow.highPass}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.HighPass}" />
                <MenuItem Header="{loc:Loc mainWindow.clarity}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.Clarity}" />
                <Separator />
                <MenuItem Header="{loc:Loc mainWindow.addNoise}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.AddNoise}" />
                <MenuItem Header="{loc:Loc mainWindow.denoise}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.Denoise}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc mainWindow.view}">
                <MenuItem x:Name="ViewZoomInItem" Header="{loc:Loc mainWindow.zoomIn}" Click="OnZoomInMenu" InputGesture="Ctrl+OemPlus" Tag="view.zoomIn" />
                <MenuItem x:Name="ViewZoomOutItem" Header="{loc:Loc mainWindow.zoomOut}" Click="OnZoomOutMenu" InputGesture="Ctrl+OemMinus" Tag="view.zoomOut" />
                <MenuItem x:Name="ViewFitItem" Header="{loc:Loc mainWindow.fitToWindow}" Click="OnZoomFit" InputGesture="Ctrl+D0" Tag="view.fit" />
                <MenuItem x:Name="ViewActualItem" Header="{loc:Loc mainWindow.actualPixels100}" Click="OnZoomActual" InputGesture="Ctrl+D1" Tag="view.actual" />
                <MenuItem x:Name="ViewHalfItem" Header="{loc:Loc mainWindow.zoom50}" Click="OnZoom50" />
                <MenuItem x:Name="ViewDoubleItem" Header="{loc:Loc mainWindow.zoom200}" Click="OnZoom200" />
                <Separator />
                <MenuItem x:Name="RulersMenuItem" Header="{loc:Loc mainWindow.showRulers}" ToggleType="CheckBox" IsChecked="True" Click="OnToggleRulers" />
                <MenuItem x:Name="GridMenuItem" Header="{loc:Loc mainWindow.showGrid}" ToggleType="CheckBox" Click="OnToggleGrid" />
                <MenuItem x:Name="PixelGridMenuItem" Header="{loc:Loc mainWindow.showPixelGrid}" ToggleType="CheckBox" IsChecked="True" Click="OnTogglePixelGrid" />
                <Separator />
                <MenuItem Header="{loc:Loc mainWindow.gridSettings}" Click="OnGridSettings" />
                <MenuItem x:Name="SnapMenuItem" Header="{loc:Loc mainWindow.snapToGuidesGrid}" ToggleType="CheckBox" IsChecked="True" Click="OnToggleSnap" />
                <MenuItem Header="{loc:Loc mainWindow.snappingSettings}" Click="OnSnapping" />
                <MenuItem Header="{loc:Loc mainWindow.clearGuides}" Click="OnClearGuides" />
            </MenuItem>
            <MenuItem Header="{loc:Loc mainWindow.ai}" x:Name="AiMenu" IsVisible="False">
                <MenuItem x:Name="AiRemoveBgItem" Header="{loc:Loc mainWindow.removeBackground}" Click="OnAiRemoveBackground" />
                <MenuItem x:Name="AiSelectItem" Header="{loc:Loc mainWindow.selectSubject}" Click="OnAiSelectSubject" />
                <MenuItem x:Name="AiSmartSelectItem" Header="{loc:Loc mainWindow.smartSelectHover}" Click="OnAiSmartSelect" />
                <MenuItem x:Name="AiUpscaleItem" Header="{loc:Loc mainWindow.upscale}" Click="OnAiUpscale" />
                <MenuItem x:Name="AiRemoveObjItem" Header="{loc:Loc mainWindow.removeObject}" Click="OnAiRemoveObject" />
                <Separator x:Name="AiGenSep" />
                <MenuItem x:Name="AiGenFillItem" Header="{loc:Loc mainWindow.generativeFill}" Click="OnAiGenerativeFill" />
                <MenuItem x:Name="AiGenImageItem" Header="{loc:Loc mainWindow.generateImage}" Click="OnAiGenerateImage" />
                <Separator />
                <MenuItem Header="{loc:Loc mainWindow.models}" Click="OnAiModels" />
            </MenuItem>
            <MenuItem Header="{loc:Loc mainWindow.window}" SubmenuOpened="OnWindowMenuOpened">
                <MenuItem x:Name="AdjustmentsMenuItem" Header="{loc:Loc mainWindow.adjustments}" Click="OnToggleAdjustments" />
                <MenuItem x:Name="EffectsMenuItem" Header="{loc:Loc mainWindow.layerEffects}" Click="OnToggleEffects" />
                <MenuItem Header="{loc:Loc mainWindow.transform}" Click="OnToggleTransform" />
                <MenuItem Header="{loc:Loc mainWindow.history}" Click="OnToggleHistory" />
                <MenuItem Header="{loc:Loc mainWindow.compatibilityReport}" Click="OnToggleCompatibilityReport" />
                <MenuItem Header="{loc:Loc mainWindow.commandPalette}" InputGesture="Ctrl+K" Click="OnCommandPalette" Tag="window.palette" />
                <Separator />
                <MenuItem x:Name="PanelToolsItem" Header="{loc:Loc mainWindow.panelTools}" ToggleType="CheckBox" IsChecked="True" Click="OnTogglePanelTools" />
                <MenuItem x:Name="PanelColorItem" Header="{loc:Loc mainWindow.panelColor}" ToggleType="CheckBox" IsChecked="True" Click="OnTogglePanelColor" />
                <MenuItem x:Name="PanelLayersItem" Header="{loc:Loc mainWindow.panelLayers}" ToggleType="CheckBox" IsChecked="True" Click="OnTogglePanelLayers" />
                <MenuItem x:Name="ContextBarItem" Header="{loc:Loc mainWindow.contextTaskBar}" ToggleType="CheckBox" IsChecked="True" Click="OnToggleContextBar" />
            </MenuItem>
            <MenuItem Header="{loc:Loc mainWindow.help}">
                <MenuItem Header="{loc:Loc mainWindow.keyboardShortcuts}" Click="OnShortcuts" />
                <Separator />
                <MenuItem Header="{loc:Loc mainWindow.checkForUpdates}" Click="OnCheckUpdatesMenu" />
                <Separator />
                <MenuItem Header="{loc:Loc mainWindow.aboutSable}" Click="OnAbout" />
            </MenuItem>
        </Menu>
        <!-- draggable empty area (last child fills; double-click toggles maximise) -->
        <Border x:Name="TitleDrag" Background="Transparent"
                PointerPressed="OnTitleBarPressed" DoubleTapped="OnTitleBarDoubleTapped" />
        </DockPanel>

        <!-- (3) Context / options bar -->
        <Border Grid.Row="1" Background="{DynamicResource ChromePanel2}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1" Height="{StaticResource OptionsBarHeight}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0" Spacing="8">
                <TextBlock x:Name="ToolStatus" Text="{loc:Loc mainWindow.brush}" Foreground="{DynamicResource ChromeText}" VerticalAlignment="Center" Width="76" />

                <!-- brush/eraser/clone/shape-line: stroke size -->
                <StackPanel x:Name="SizeOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <ComboBox x:Name="BrushPresetCombo" Width="110" SelectionChanged="OnBrushPresetSelected"
                              PlaceholderText="{loc:Loc mainWindow.brushPresets}" VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Loc mainWindow.brushPresetsTip}" />
                    <Button Classes="iconbtn" Width="20" Click="OnSaveBrushPreset" ToolTip.Tip="{loc:Loc mainWindow.savePreset}" VerticalAlignment="Center">
                        <Path Classes="icon" Width="11" Height="11" Data="M12 5v14 M5 12h14" />
                    </Button>
                    <Button Classes="iconbtn" Width="20" Click="OnDeleteBrushPreset" ToolTip.Tip="{loc:Loc mainWindow.deletePreset}" VerticalAlignment="Center">
                        <Path Classes="icon" Width="11" Height="11" Data="M5 5l14 14 M19 5l-14 14" />
                    </Button>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="{loc:Loc mainWindow.size}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <Slider x:Name="BrushSizeSlider" Width="120" Minimum="1" Maximum="200" Value="16"
                            ValueChanged="OnBrushSizeChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="BrushSizeLabel" Text="{loc:Loc mainWindow.16Px}" Foreground="{DynamicResource ChromeTextDim}"
                               VerticalAlignment="Center" FontSize="11" Width="44" />
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="{loc:Loc mainWindow.hardness}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <Slider x:Name="BrushHardnessSlider" Width="90" Minimum="0" Maximum="100" Value="50"
                            ValueChanged="OnBrushHardnessChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="BrushHardnessLabel" Text="50%" Foreground="{DynamicResource ChromeTextDim}"
                               VerticalAlignment="Center" FontSize="11" Width="36" />
                    <StackPanel x:Name="FlowOpts" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                        <TextBlock Text="{loc:Loc mainWindow.flow}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                        <Slider x:Name="BrushFlowSlider" Width="90" Minimum="1" Maximum="100" Value="100"
                                ValueChanged="OnBrushFlowChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="BrushFlowLabel" Text="100%" Foreground="{DynamicResource ChromeTextDim}"
                                   VerticalAlignment="Center" FontSize="11" Width="36" />
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                        <TextBlock Text="{loc:Loc mainWindow.smoothing}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                        <Slider x:Name="BrushSmoothSlider" Width="70" Minimum="0" Maximum="100" Value="0"
                                ValueChanged="OnBrushSmoothChanged" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Loc mainWindow.smoothingTip}" />
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                        <TextBlock Text="{loc:Loc mainWindow.spacing}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                        <Slider x:Name="BrushSpacingSlider" Width="70" Minimum="0" Maximum="200" Value="0"
                                ValueChanged="OnBrushSpacingChanged" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Loc mainWindow.spacingTip}" />
                        <CheckBox x:Name="PressureSizeCheck" Content="{loc:Loc mainWindow.pressureSize}" FontSize="11" IsChecked="True"
                                  Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" Click="OnPressureToggles"
                                  ToolTip.Tip="{loc:Loc mainWindow.pressureSizeTip}" />
                        <CheckBox x:Name="PressureFlowCheck" Content="{loc:Loc mainWindow.pressureFlow}" FontSize="11"
                                  Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" Click="OnPressureToggles"
                                  ToolTip.Tip="{loc:Loc mainWindow.pressureFlowTip}" />
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                        <Button x:Name="DynamicsBtn" Classes="iconbtn" Width="22" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Loc mainWindow.brushDynamicsTip}">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Width="250" Spacing="2">
                                        <local:LabeledSlider x:Name="DynAngle" Label="{loc:Loc mainWindow.brushAngle}" Minimum="-180" Maximum="180" Value="0" />
                                        <local:LabeledSlider x:Name="DynRoundness" Label="{loc:Loc mainWindow.brushRoundness}" Minimum="3" Maximum="100" Value="100" />
                                        <local:LabeledSlider x:Name="DynSizeJitter" Label="{loc:Loc mainWindow.sizeJitter}" Minimum="0" Maximum="100" Value="0" />
                                        <local:LabeledSlider x:Name="DynFlowJitter" Label="{loc:Loc mainWindow.flowJitter}" Minimum="0" Maximum="100" Value="0" />
                                        <local:LabeledSlider x:Name="DynScatter" Label="{loc:Loc mainWindow.scatterJitter}" Minimum="0" Maximum="100" Value="0" />
                                        <local:LabeledSlider x:Name="DynAngleJitter" Label="{loc:Loc mainWindow.angleJitter}" Minimum="0" Maximum="100" Value="0" />
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock Text="{loc:Loc mainWindow.paintBlend}" Foreground="{DynamicResource ChromeTextDim}"
                                                       FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0" />
                                            <ComboBox x:Name="BrushBlendCombo" FontSize="11" HorizontalAlignment="Stretch"
                                                      SelectionChanged="OnBrushBlendChanged" />
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock x:Name="BrushTipLabel" Text="" Foreground="{DynamicResource ChromeTextDim}"
                                                       FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                            <Button Content="{loc:Loc mainWindow.clearTip}" x:Name="ClearTipBtn" FontSize="11" Height="22"
                                                    HorizontalAlignment="Right" Click="OnClearBrushTip" IsVisible="False" />
                                        </DockPanel>
                                        <Button Content="{loc:Loc mainWindow.importAbr}" FontSize="11" Height="24"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Click="OnImportAbr" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <Path Classes="icon" Width="12" Height="12" Data="M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M1 14h6 M9 8h6 M17 16h6" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- retouch brushes: effect strength -->
                <StackPanel x:Name="StrengthOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="{loc:Loc mainWindow.strength}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <Slider x:Name="StrengthSlider" Width="120" Minimum="1" Maximum="100" Value="50"
                            ValueChanged="OnStrengthChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="StrengthLabel" Text="50%" Foreground="{DynamicResource ChromeTextDim}"
                               VerticalAlignment="Center" FontSize="11" Width="40" />
                </StackPanel>

                <!-- selection tools: feather -->
                <StackPanel x:Name="SelectOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="{loc:Loc mainWindow.feather}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <Slider x:Name="FeatherSlider" Width="110" Minimum="0" Maximum="50" Value="0"
                            ValueChanged="OnFeatherChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="FeatherLabel" Text="{loc:Loc mainWindow.0Px}" Foreground="{DynamicResource ChromeTextDim}"
                               VerticalAlignment="Center" FontSize="11" Width="40" />
                </StackPanel>

                <!-- type tool: font controls -->
                <StackPanel x:Name="TypeOpts" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <ComboBox x:Name="FontCombo" Width="150" FontSize="11" VerticalAlignment="Center"
                              SelectionChanged="OnFontChanged" />
                    <ToggleButton Classes="opt" x:Name="BoldBtn" Content="B" Width="26" Height="24" FontWeight="Bold"
                                  VerticalAlignment="Center" Click="OnFontStyleChanged" ToolTip.Tip="{loc:Loc mainWindow.bold}" />
                    <ToggleButton Classes="opt" x:Name="ItalicBtn" Content="I" Width="26" Height="24" FontStyle="Italic"
                                  VerticalAlignment="Center" Click="OnFontStyleChanged" ToolTip.Tip="{loc:Loc mainWindow.italic}" />
                    <ToggleButton Classes="opt" x:Name="UnderlineBtn" Content="U" Width="26" Height="24"
                                  VerticalAlignment="Center" Click="OnFontStyleChanged" ToolTip.Tip="{loc:Loc mainWindow.underline}" />
                    <ToggleButton Classes="opt" x:Name="StrikeBtn" Content="S" Width="26" Height="24"
                                  VerticalAlignment="Center" Click="OnFontStyleChanged" ToolTip.Tip="{loc:Loc mainWindow.strikethrough}" />
                    <TextBox x:Name="TypeSizeBox" Width="48" Text="48" TextAlignment="Center"
                             TextChanged="OnTypeSizeChanged"
                             VerticalAlignment="Center" ToolTip.Tip="{loc:Loc mainWindow.fontSize}" />
                    <ToggleButton Classes="opt" x:Name="AlignLeftBtn" Width="26" Height="24" VerticalAlignment="Center"
                                  Click="OnAlignChanged" Tag="0" ToolTip.Tip="{loc:Loc mainWindow.alignLeft2}">
                        <Path Classes="icon" Width="14" Height="14" Data="M3 6h18 M3 12h12 M3 18h15" />
                    </ToggleButton>
                    <ToggleButton Classes="opt" x:Name="AlignCenterBtn" Width="26" Height="24" VerticalAlignment="Center"
                                  Click="OnAlignChanged" Tag="1" ToolTip.Tip="{loc:Loc mainWindow.alignCenter2}">
                        <Path Classes="icon" Width="14" Height="14" Data="M3 6h18 M6 12h12 M4 18h16" />
                    </ToggleButton>
                    <ToggleButton Classes="opt" x:Name="AlignRightBtn" Width="26" Height="24" VerticalAlignment="Center"
                                  Click="OnAlignChanged" Tag="2" ToolTip.Tip="{loc:Loc mainWindow.alignRight2}">
                        <Path Classes="icon" Width="14" Height="14" Data="M3 6h18 M9 12h12 M6 18h15" />
                    </ToggleButton>
                    <TextBox x:Name="LineSpacingBox" Width="48" Text="100" TextAlignment="Center"
                             TextChanged="OnLineSpacingChanged"
                             VerticalAlignment="Center" ToolTip.Tip="{loc:Loc mainWindow.lineSpacing}" />
                    <TextBlock Text="{loc:Loc mainWindow.boxW}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="BoxWidthBox" Width="48" Text="0" TextAlignment="Center"
                             TextChanged="OnBoxWidthChanged"
                             VerticalAlignment="Center" ToolTip.Tip="{loc:Loc mainWindow.areaTextWrapWidth0}" />
                    <TextBlock Text="{loc:Loc mainWindow.tracking}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="TrackingBox" Width="44" Text="0" TextAlignment="Center"
                             TextChanged="OnTrackingChanged"
                             VerticalAlignment="Center" ToolTip.Tip="{loc:Loc mainWindow.letterSpacingPx}" />
                </StackPanel>

                <!-- eyedropper: sample size + source -->
                <StackPanel x:Name="EyedropperOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="{loc:Loc mainWindow.sample}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <ComboBox x:Name="EyedropperSampleCombo" Width="84" SelectedIndex="0" SelectionChanged="OnEyedropperSampleChanged">
                        <ComboBoxItem>Point</ComboBoxItem>
                        <ComboBoxItem>3 x 3</ComboBoxItem>
                        <ComboBoxItem>5 x 5</ComboBoxItem>
                    </ComboBox>
                    <CheckBox Content="{loc:Loc mainWindow.allLayers}" FontSize="11" Foreground="{DynamicResource ChromeText}"
                              IsChecked="False" IsCheckedChanged="OnEyedropperAllLayersChanged" />
                </StackPanel>

                <!-- gradient tool: ramp geometry -->
                <StackPanel x:Name="GradOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="{loc:Loc mainWindow.gradShape}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <ComboBox x:Name="GradShapeCombo" Width="110" SelectedIndex="0" SelectionChanged="OnGradShapeChanged">
                        <ComboBoxItem Content="{loc:Loc mainWindow.gradLinear}" />
                        <ComboBoxItem Content="{loc:Loc mainWindow.gradRadial}" />
                        <ComboBoxItem Content="{loc:Loc mainWindow.gradConical}" />
                        <ComboBoxItem Content="{loc:Loc mainWindow.gradReflected}" />
                        <ComboBoxItem Content="{loc:Loc mainWindow.gradDiamond}" />
                    </ComboBox>
                </StackPanel>

                <!-- crop tool: aspect preset + keep/delete pixels -->
                <StackPanel x:Name="CropOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="{loc:Loc mainWindow.cropAspect}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <ComboBox x:Name="CropAspectCombo" Width="84" SelectedIndex="0" SelectionChanged="OnCropAspectChanged">
                        <ComboBoxItem Content="{loc:Loc mainWindow.cropFree}" />
                        <ComboBoxItem>1:1</ComboBoxItem>
                        <ComboBoxItem>4:3</ComboBoxItem>
                        <ComboBoxItem>3:2</ComboBoxItem>
                        <ComboBoxItem>16:9</ComboBoxItem>
                    </ComboBox>
                    <CheckBox x:Name="CropDeleteCheck" Content="{loc:Loc mainWindow.cropDelete}" FontSize="11"
                              Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" Click="OnCropDeleteChanged"
                              ToolTip.Tip="{loc:Loc mainWindow.cropDeleteTip}" />
                </StackPanel>

                <!-- liquify: displacement mode -->
                <StackPanel x:Name="LiquifyOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="{loc:Loc mainWindow.mode}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <ComboBox x:Name="LiquifyModeCombo" Width="92" SelectedIndex="0" SelectionChanged="OnLiquifyModeChanged">
                        <ComboBoxItem>Push</ComboBoxItem>
                        <ComboBoxItem>Bloat</ComboBoxItem>
                        <ComboBoxItem>Pucker</ComboBoxItem>
                        <ComboBoxItem>Twirl</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- shape tools: fill / stroke / dash / per-kind params (draw-time defaults) -->
                <StackPanel x:Name="ShapeOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <CheckBox x:Name="ShapeFillChk" Content="{loc:Loc mainWindow.fill}" FontSize="11" Foreground="{DynamicResource ChromeText}"
                              IsChecked="True" IsCheckedChanged="OnShapeOptChanged" VerticalAlignment="Center" />
                    <CheckBox x:Name="ShapeStrokeChk" Content="{loc:Loc mainWindow.stroke}" FontSize="11" Foreground="{DynamicResource ChromeText}"
                              IsChecked="False" IsCheckedChanged="OnShapeOptChanged" VerticalAlignment="Center" />
                    <TextBlock Text="W" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <Slider x:Name="ShapeStrokeWidth" Width="80" Minimum="1" Maximum="50" Value="3"
                            ValueChanged="OnShapeWidthChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="ShapeStrokeWidthLabel" Text="{loc:Loc mainWindow.3Px}" Foreground="{DynamicResource ChromeTextDim}"
                               VerticalAlignment="Center" FontSize="11" Width="36" />
                    <CheckBox x:Name="ShapeDashChk" Content="{loc:Loc mainWindow.dash}" FontSize="11" Foreground="{DynamicResource ChromeText}"
                              IsChecked="False" IsCheckedChanged="OnShapeOptChanged" VerticalAlignment="Center" />
                    <StackPanel x:Name="ShapeSidesOpts" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc mainWindow.sides}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                        <TextBox x:Name="ShapeSidesBox" Width="40" Text="5" TextAlignment="Center"
                                 TextChanged="OnShapeNumChanged" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="ShapeInnerOpts" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc mainWindow.inner}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                        <TextBox x:Name="ShapeInnerBox" Width="44" Text="50" TextAlignment="Center"
                                 TextChanged="OnShapeNumChanged" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="ShapeCornerOpts" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc mainWindow.radius}" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                        <TextBox x:Name="ShapeCornerBox" Width="44" Text="12" TextAlignment="Center"
                                 TextChanged="OnShapeNumChanged" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- brush/eraser: mask-edit hint -->
                <StackPanel x:Name="MaskHint" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="{loc:Loc mainWindow.kEditMask}" Foreground="{DynamicResource ChromeTextFaint}" VerticalAlignment="Center" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main work area: (2) tools | (1) canvas | (5/6) panels (fixed layout — docking removed) -->
        <Grid x:Name="MainSplit" Grid.Row="2" ColumnDefinitions="40,*,300">

            <!-- (2) Tool palette -->
            <Border x:Name="ToolStripHost" Grid.Column="0" Background="{DynamicResource ChromePanel}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,1,0">
                <!-- tool strip is generated in code (grouped slots + flyouts), see BuildToolStrip() -->
                <StackPanel x:Name="ToolStrip" Margin="0,6" HorizontalAlignment="Center" />
            </Border>

            <!-- (1) Canvas area: document tabs + GPU surface mount point -->
            <Grid x:Name="CanvasArea" Grid.Column="1" RowDefinitions="28,*,22" Background="{DynamicResource ChromeCanvas}">
                <!-- document tabs (multi-doc) -->
                <Border Grid.Row="0" Background="{DynamicResource ChromePanel2}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="6,0">
                        <ItemsControl x:Name="TabStrip" VerticalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:DocumentTab">
                                    <Border Padding="10,0,6,0" Margin="2,4,0,0" CornerRadius="4,4,0,0"
                                            PointerPressed="OnSelectTab" PointerReleased="OnTabPointerReleased" Tag="{Binding}"
                                            Background="{Binding IsActive, Converter={x:Static local:BoolToTabBgConverter.Instance}}">
                                        <ToolTip.Tip>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Title}" FontSize="11" />
                                                <Image Source="{Binding Preview}" MaxWidth="180" MaxHeight="135"
                                                       Stretch="Uniform" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                        </ToolTip.Tip>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource ChromeText}" FontSize="12" VerticalAlignment="Center" />
                                            <Button Classes="iconbtn" Width="14" Height="14" Padding="0" Click="OnCloseTab" Tag="{Binding}"
                                                    ToolTip.Tip="{loc:Loc mainWindow.closeTab}" VerticalAlignment="Center">
                                                <TextBlock Text="×" FontSize="13" Foreground="{DynamicResource ChromeTextDim}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="iconbtn" Width="22" Click="OnNewTabButton" ToolTip.Tip="{loc:Loc mainWindow.newDocument}" VerticalAlignment="Center" Margin="4,0,0,0">
                            <Path Classes="icon" Width="14" Height="14" Data="M12 5v14 M5 12h14" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- canvas viewport: rulers (top/left) flush with the embedded wgpu surface -->
                <Grid x:Name="CanvasGrid" Grid.Row="1" Background="{DynamicResource ChromeCanvas}"
                      RowDefinitions="18,*" ColumnDefinitions="18,*">
                    <!-- corner box -->
                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource ChromePanel2}"
                            BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,1,1" />
                    <local:Ruler x:Name="RulerH" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" />
                    <local:Ruler x:Name="RulerV" Grid.Row="1" Grid.Column="0" Orientation="Vertical" />
                    <Panel Grid.Row="1" Grid.Column="1">
                        <canvas:GpuSurfaceControl x:Name="Canvas" />
                        <Border x:Name="InputLayer" Background="Transparent"
                                PointerWheelChanged="OnCanvasWheel"
                                PointerPressed="OnCanvasPointerPressed"
                                PointerMoved="OnCanvasPointerMoved"
                                PointerReleased="OnCanvasPointerReleased"
                                DoubleTapped="OnCanvasDoubleTapped" />
                        <!-- empty / welcome state (no open document) -->
                        <StackPanel x:Name="EmptyState" IsVisible="False" Spacing="10"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc mainWindow.noDocumentOpen}" Foreground="{DynamicResource ChromeTextFaint}" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc mainWindow.fileNewCtrlNOpen}"
                                       Foreground="#FF5A5A5A" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock x:Name="WelcomeRecentHeader" Text="{loc:Loc mainWindow.recentFiles}" IsVisible="False"
                                       Foreground="{DynamicResource ChromeTextDim}" FontSize="12" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <WrapPanel x:Name="WelcomeRecents" HorizontalAlignment="Center" MaxWidth="560" />
                            <CheckBox x:Name="WelcomeShowCheck" Content="{loc:Loc mainWindow.showWelcomeScreen}"
                                      FontSize="11" Foreground="{DynamicResource ChromeTextDim}" IsChecked="True"
                                      HorizontalAlignment="Center" Margin="0,16,0,0" Click="OnToggleWelcome" />
                        </StackPanel>
                    </Panel>
                </Grid>

                <!-- status strip: live zoom UI + document info + cursor position -->
                <Border Grid.Row="2" Background="{DynamicResource ChromePanel2}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0">
                    <DockPanel Margin="8,0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <Button Classes="iconbtn" Width="24" Height="20" Click="OnZoomFit" ToolTip.Tip="{loc:Loc mainWindow.fit0}">
                                <Path Classes="icon" Width="13" Height="13" Data="M3 8V3h5 M16 3h5v5 M21 16v5h-5 M8 21H3v-5" />
                            </Button>
                            <Button Classes="iconbtn" Width="24" Height="20" Click="OnZoomActual" ToolTip.Tip="100%">
                                <TextBlock Text="1:1" FontSize="10" Foreground="{DynamicResource ChromeText}" />
                            </Button>
                            <TextBox x:Name="ZoomBox" Width="54" Text="100%" FontSize="11" TextAlignment="Center"
                                     VerticalContentAlignment="Center" KeyDown="OnZoomBoxKey" ToolTip.Tip="{loc:Loc mainWindow.zoomLevel}" />
                            <Rectangle Width="1" Height="14" Fill="{DynamicResource ChromeBorder}" />
                            <TextBlock x:Name="DocInfoLabel" Text="—" Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" />
                            <Rectangle Width="1" Height="14" Fill="{DynamicResource ChromeBorder}" />
                            <TextBlock x:Name="CursorLabel" Text="" Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" Width="110" />
                            <Border x:Name="InfoSwatch" Width="13" Height="13" BorderBrush="{DynamicResource ChromeBorder2}" BorderThickness="1"
                                    Background="Transparent" VerticalAlignment="Center" />
                            <TextBlock x:Name="InfoLabel" Text="" Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" Width="150" />
                            <Rectangle Width="1" Height="14" Fill="{DynamicResource ChromeBorder}" />
                            <TextBlock x:Name="SelSizeLabel" Text="" Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" Width="90" />
                            <Rectangle Width="1" Height="14" Fill="{DynamicResource ChromeBorder}" />
                            <TextBlock x:Name="ColorSpaceLabel" Text="—" Foreground="{DynamicResource ChromeTextFaint}" FontSize="11" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Loc mainWindow.documentColourModeDepth}" />
                            <Rectangle Width="1" Height="14" Fill="{DynamicResource ChromeBorder}" />
                            <TextBlock x:Name="MemLabel" Text="" Foreground="{DynamicResource ChromeTextFaint}" FontSize="11" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Loc mainWindow.memoryUsage}" />
                            <Rectangle Width="1" Height="14" Fill="{DynamicResource ChromeBorder}" />
                        </StackPanel>
                        <!-- active-tool modifier hints (Affinity-style) -->
                        <TextBlock x:Name="ToolHint" Foreground="{DynamicResource ChromeTextDim}" FontSize="11"
                                   VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- (5/6) Right panel stack: Color/Swatches + Layers -->
            <Border x:Name="RightPanelRoot" Grid.Column="2" Background="{DynamicResource ChromePanel}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- (6) Color / Gradients / Swatches / Histogram tabs -->
                    <DockPanel x:Name="ColorPanelRoot" Grid.Row="0" x:DataType="vm:DocumentViewModel" Background="{DynamicResource ChromePanel}">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeFooter}">
                            <!-- 5 tabs don't fit 300px (esp. German) → wrap to a 2nd row so all stay visible -->
                            <WrapPanel>
                                <TextBlock x:Name="TabColor" Classes="panelHeader" Text="{loc:Loc mainWindow.color}" PointerPressed="OnSelectColorTab" Tag="color" />
                                <TextBlock x:Name="TabGrad" Classes="panelHeader" Text="{loc:Loc mainWindow.gradients}"
                                           Foreground="{DynamicResource ChromeTextFaint}" PointerPressed="OnSelectColorTab" Tag="grad" />
                                <TextBlock x:Name="TabSwatches" Classes="panelHeader" Text="{loc:Loc mainWindow.swatches}"
                                           Foreground="{DynamicResource ChromeTextFaint}" PointerPressed="OnSelectColorTab" Tag="swatch" />
                                <TextBlock x:Name="TabHist" Classes="panelHeader" Text="{loc:Loc mainWindow.histogram}"
                                           Foreground="{DynamicResource ChromeTextFaint}" PointerPressed="OnSelectColorTab" Tag="hist" />
                                <TextBlock x:Name="TabNav" Classes="panelHeader" Text="{loc:Loc mainWindow.navigator}"
                                           Foreground="{DynamicResource ChromeTextFaint}" PointerPressed="OnSelectColorTab" Tag="nav" />
                            </WrapPanel>
                        </Border>

                        <Panel>
                            <!-- COLOR tab: picker-mode dropdown (wheel OR sliders) + fg/bg + alpha -->
                            <ScrollViewer x:Name="ColorTabPanel" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8,8,8,6" Spacing="6">
                                    <ComboBox x:Name="ColorModeCombo" SelectedIndex="0" SelectionChanged="OnColorModeChanged" Width="100" HorizontalAlignment="Left" FontSize="11">
                                        <ComboBoxItem>Wheel</ComboBoxItem>
                                        <ComboBoxItem>RGB</ComboBoxItem>
                                        <ComboBoxItem>HSL</ComboBoxItem>
                                        <ComboBoxItem>CMYK</ComboBoxItem>
                                        <ComboBoxItem>LAB</ComboBoxItem>
                                    </ComboBox>
                                    <local:ColorPicker x:Name="BrushColorView" />
                                    <StackPanel x:Name="ColorSliderRows" Spacing="6" IsVisible="False">
                                        <Grid ColumnDefinitions="22,*,42" x:Name="CRow0" RowDefinitions="Auto">
                                            <TextBlock x:Name="CLbl0" Grid.Column="0" Text="R" Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" />
                                            <Slider x:Name="CSlider0" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnColorSlider" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <TextBox x:Name="CVal0" Grid.Column="2" FontSize="11" Text="0" TextChanged="OnColorValBox" />
                                        </Grid>
                                        <Grid ColumnDefinitions="22,*,42" x:Name="CRow1">
                                            <TextBlock x:Name="CLbl1" Grid.Column="0" Text="G" Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" />
                                            <Slider x:Name="CSlider1" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnColorSlider" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <TextBox x:Name="CVal1" Grid.Column="2" FontSize="11" Text="0" TextChanged="OnColorValBox" />
                                        </Grid>
                                        <Grid ColumnDefinitions="22,*,42" x:Name="CRow2">
                                            <TextBlock x:Name="CLbl2" Grid.Column="0" Text="B" Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" />
                                            <Slider x:Name="CSlider2" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnColorSlider" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <TextBox x:Name="CVal2" Grid.Column="2" FontSize="11" Text="0" TextChanged="OnColorValBox" />
                                        </Grid>
                                        <Grid ColumnDefinitions="22,*,42" x:Name="CRow3">
                                            <TextBlock x:Name="CLbl3" Grid.Column="0" Text="K" Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" />
                                            <Slider x:Name="CSlider3" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="OnColorSlider" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <TextBox x:Name="CVal3" Grid.Column="2" FontSize="11" Text="0" TextChanged="OnColorValBox" />
                                        </Grid>
                                    </StackPanel>
                                    <!-- foreground/background swatches + swap/reset + alpha -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid Width="44" Height="40">
                                            <Border x:Name="BgSwatch" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Background="White" BorderBrush="{DynamicResource ChromeBorder2}" BorderThickness="1" Tapped="OnPickBg" />
                                            <Border x:Name="FgSwatch" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Background="Black" BorderBrush="{DynamicResource ChromeBorder2}" BorderThickness="1" Tapped="OnPickFg" />
                                        </Grid>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <Button Classes="iconbtn" Click="OnSwapColors" ToolTip.Tip="{loc:Loc mainWindow.swapForegroundBackgroundX}">
                                                <Path Classes="icon" Width="13" Height="13" Data="M16 3l4 4-4 4 M20 7H9 M8 21l-4-4 4-4 M4 17h11" />
                                            </Button>
                                            <Button Classes="iconbtn" Click="OnResetColors" ToolTip.Tip="{loc:Loc mainWindow.resetToBlackWhiteD}">
                                                <Path Classes="icon" Width="12" Height="12" Data="M4 4h16v16H4z" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Width="110">
                                            <TextBlock Text="{loc:Loc mainWindow.alpha}" Foreground="{DynamicResource ChromeTextDim}" FontSize="10" />
                                            <Slider x:Name="AlphaSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="OnAlphaChanged" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- GRADIENTS tab: draggable stop bar + add/remove -->
                            <StackPanel x:Name="GradientPanel" IsVisible="False" Margin="8,8,8,6" Spacing="4">
                                <local:GradientBar x:Name="GradBar" Height="42" />
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="iconbtn" Click="OnGradAddStop" ToolTip.Tip="{loc:Loc mainWindow.addStop}">
                                        <Path Classes="icon" Width="14" Height="14" Data="M12 5v14 M5 12h14" />
                                    </Button>
                                    <Button Classes="iconbtn" Click="OnGradDelStop" ToolTip.Tip="{loc:Loc mainWindow.deleteSelectedStop}">
                                        <Path Classes="icon" Width="14" Height="14" Data="M5 12h14" />
                                    </Button>
                                    <TextBlock Text="{loc:Loc mainWindow.clickBarAddDragMove}"
                                               Foreground="{DynamicResource ChromeTextFaint}" FontSize="10" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Width="200" />
                                </StackPanel>
                            </StackPanel>

                            <!-- SWATCHES tab -->
                            <ScrollViewer x:Name="SwatchesTabPanel" IsVisible="False" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8" Spacing="6">
                                    <ItemsControl x:Name="SwatchList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Button Classes="iconbtn" Content="{loc:Loc mainWindow.addSwatch}" FontSize="10" HorizontalAlignment="Left" Click="OnAddSwatch" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- HISTOGRAM tab -->
                            <StackPanel x:Name="HistogramTabPanel" IsVisible="False" Margin="8">
                                <local:HistogramView x:Name="HistView" Height="120" />
                            </StackPanel>

                            <!-- NAVIGATOR tab -->
                            <StackPanel x:Name="NavigatorTabPanel" IsVisible="False" Margin="8" Spacing="6">
                                <local:NavigatorView x:Name="NavView" Height="150" />
                                <Slider x:Name="NavZoomSlider" Minimum="5" Maximum="800" Value="100" ValueChanged="OnNavZoom" />
                            </StackPanel>
                        </Panel>
                    </DockPanel>

                    <GridSplitter x:Name="PanelSplitter" Grid.Row="1" Height="4" Background="{DynamicResource ChromeWindowBg}"
                                  HorizontalAlignment="Stretch" />

                    <!-- (5) Layers / Channels / Paths -->
                    <DockPanel x:Name="LayersPanelRoot" Grid.Row="2" x:DataType="vm:DocumentViewModel" Background="{DynamicResource ChromePanel}">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeFooter}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TabLayers" Classes="panelHeader" Text="{loc:Loc mainWindow.layers}"
                                           PointerPressed="OnSelectLayerTab" Tag="layers" />
                                <TextBlock x:Name="TabChannels" Classes="panelHeader" Text="{loc:Loc mainWindow.channels}"
                                           Foreground="{DynamicResource ChromeTextFaint}" PointerPressed="OnSelectLayerTab" Tag="channels" />
                                <TextBlock Classes="panelHeader" Text="{loc:Loc mainWindow.paths}" Foreground="{DynamicResource ChromeTextFaint}" />
                            </StackPanel>
                        </Border>
                        <!-- Layers / Channels bodies share the panel; the header tabs toggle them -->
                        <Panel>
                        <DockPanel x:Name="ChannelsBody" IsVisible="False">
                            <ScrollViewer>
                                <StackPanel x:Name="ChannelRows" Margin="0,2" />
                            </ScrollViewer>
                        </DockPanel>
                        <DockPanel x:Name="LayersBody">
                        <!-- blend mode + opacity row (bound to selected layer; hidden when nothing is selected) -->
                        <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource ChromePanel3}"
                                IsVisible="{Binding SelectedLayer, Converter={x:Static ac:ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox Width="130" FontSize="11"
                                              ItemsSource="{Binding BlendModes}"
                                              SelectedItem="{Binding SelectedLayer.BlendMode, Mode=TwoWay}" />
                                    <TextBlock Text="{Binding SelectedLayer.OpacityLabel}"
                                               Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <Slider Minimum="0" Maximum="100"
                                        Value="{Binding SelectedLayer.OpacityPercent, Mode=TwoWay}" />
                                <TextBlock Text="{Binding SelectedLayer.FillOpacityLabel}"
                                           Foreground="{DynamicResource ChromeTextDim}" FontSize="11" />
                                <Slider Minimum="0" Maximum="100"
                                        Value="{Binding SelectedLayer.FillOpacityPercent, Mode=TwoWay}" />
                                <CheckBox Content="{loc:Loc mainWindow.clipToLayerBelow}" FontSize="11" Foreground="{DynamicResource ChromeText}"
                                          IsChecked="{Binding SelectedLayer.ClipToBelow, Mode=TwoWay}" />
                                <CheckBox Content="{loc:Loc mainWindow.passThrough}" FontSize="11" Foreground="{DynamicResource ChromeText}"
                                          IsVisible="{Binding SelectedLayer.IsGroup, FallbackValue=False}"
                                          ToolTip.Tip="{loc:Loc mainWindow.passThroughTip}"
                                          IsChecked="{Binding SelectedLayer.PassThrough, Mode=TwoWay}" />
                                <!-- locks + colour tag (act on the selected layer) -->
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc mainWindow.lock}" Foreground="{DynamicResource ChromeTextDim}" FontSize="10" VerticalAlignment="Center" />
                                    <ToggleButton Classes="opt" Width="26" Content="{loc:Loc mainWindow.pos}" FontSize="10"
                                                  ToolTip.Tip="{loc:Loc mainWindow.lockPositionTransform}"
                                                  IsChecked="{Binding SelectedLayer.LockPosition, Mode=TwoWay}" />
                                    <ToggleButton Classes="opt" Width="26" Content="{loc:Loc mainWindow.pix}" FontSize="10"
                                                  ToolTip.Tip="{loc:Loc mainWindow.lockPixels}"
                                                  IsChecked="{Binding SelectedLayer.LockPixels, Mode=TwoWay}" />
                                    <ToggleButton Classes="opt" Width="22" Content="α" FontSize="11"
                                                  ToolTip.Tip="{loc:Loc mainWindow.lockTransparencyPreserveAlpha}"
                                                  IsChecked="{Binding SelectedLayer.LockAlpha, Mode=TwoWay}" />
                                    <Border Width="8" />
                                    <ItemsControl ItemsSource="{Binding TagSwatches}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TagSwatch">
                                                <Button Width="14" Height="14" Padding="0" CornerRadius="7"
                                                        Background="{Binding Brush}" BorderBrush="#FF555555" BorderThickness="1"
                                                        Click="OnSetTag" Tag="{Binding Index}" ToolTip.Tip="{loc:Loc mainWindow.colourTag}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- contextual parameter editor (Affinity-style, docked BELOW the layers panel
                             instead of a floating window): adjustment/filter params when an effect layer
                             is selected, shape properties when a shape layer is selected -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromePanel}" MaxHeight="400"
                                BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0"
                                IsVisible="{Binding SelectedLayer.IsEffect, FallbackValue=False}">
                            <local:AdjustmentPanel x:Name="AdjPanel" />
                        </Border>
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromePanel}" MaxHeight="400"
                                BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0"
                                IsVisible="{Binding SelectedLayer.IsShape, FallbackValue=False}">
                            <local:ShapePanel x:Name="ShapePanelCtl" />
                        </Border>
                        <!-- footer buttons (bound to undoable layer commands) -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeFooter}"
                                Height="{StaticResource StatusBarHeight}" Padding="6,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- left cluster: add layer / mask / adjustments / live filters / group -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                    <Button Classes="iconbtn" Command="{Binding NewLayerCommand}" ToolTip.Tip="{loc:Loc mainWindow.newPixelLayer}">
                                        <Path Classes="icon" Width="14" Height="14" Data="M12 5v14 M5 12h14" />
                                    </Button>
                                    <Button Classes="iconbtn" Command="{Binding ToggleMaskCommand}" ToolTip.Tip="{loc:Loc mainWindow.addRemoveMask}">
                                        <Path Classes="icon" Width="14" Height="14"
                                              Data="M4 4h16v16H4z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                                    </Button>
                                    <!-- adjustments flyout (Affinity half-circle) -->
                                    <Button Classes="iconbtn" ToolTip.Tip="{loc:Loc mainWindow.addAdjustment}">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{loc:Loc mainWindow.brightnessContrast}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.BrightnessContrast}" />
                                                <MenuItem Header="{loc:Loc mainWindow.levels}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Levels}" />
                                                <MenuItem Header="{loc:Loc mainWindow.curves}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Curves}" />
                                                <MenuItem Header="{loc:Loc mainWindow.hsl}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Hsl}" />
                                                <MenuItem Header="{loc:Loc mainWindow.whiteBalance}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.WhiteBalance}" />
                                                <MenuItem Header="{loc:Loc mainWindow.blackWhite}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.BlackWhite}" />
                                                <MenuItem Header="{loc:Loc mainWindow.colourBalance}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.ColorBalance}" />
                                                <MenuItem Header="{loc:Loc mainWindow.channelMixer}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.ChannelMixer}" />
                                                <MenuItem Header="{loc:Loc mainWindow.shadowsHighlights}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.ShadowsHighlights}" />
                                                <MenuItem Header="{loc:Loc mainWindow.gradientMap}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.GradientMap}" />
                                                <Separator />
                                                <MenuItem Header="{loc:Loc mainWindow.exposure}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Exposure}" />
                                                <MenuItem Header="{loc:Loc mainWindow.vibrance}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Vibrance}" />
                                                <MenuItem Header="{loc:Loc mainWindow.threshold}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Threshold}" />
                                                <MenuItem Header="{loc:Loc mainWindow.posterise}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Posterize}" />
                                                <MenuItem Header="{loc:Loc mainWindow.invert}" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Invert}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <Path Classes="icon" Width="14" Height="14"
                                              Data="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 3v18" />
                                    </Button>
                                    <!-- live filters flyout -->
                                    <Button Classes="iconbtn" ToolTip.Tip="{loc:Loc mainWindow.addLiveFilter}">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{loc:Loc mainWindow.gaussianBlur}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.GaussianBlur}" />
                                                <MenuItem Header="{loc:Loc mainWindow.boxBlur}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.BoxBlur}" />
                                                <MenuItem Header="{loc:Loc mainWindow.motionBlur}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.MotionBlur}" />
                                                <MenuItem Header="{loc:Loc mainWindow.zoomBlur}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.ZoomBlur}" />
                                                <Separator />
                                                <MenuItem Header="{loc:Loc mainWindow.sharpen}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.Sharpen}" />
                                                <MenuItem Header="{loc:Loc mainWindow.unsharpMask}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.UnsharpMask}" />
                                                <MenuItem Header="{loc:Loc mainWindow.highPass}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.HighPass}" />
                                                <MenuItem Header="{loc:Loc mainWindow.clarity}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.Clarity}" />
                                                <Separator />
                                                <MenuItem Header="{loc:Loc mainWindow.addNoise}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.AddNoise}" />
                                                <MenuItem Header="{loc:Loc mainWindow.denoise}" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.Denoise}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <Path Classes="icon" Width="14" Height="14"
                                              Data="M12 2.7s5 5.3 5 9.3a5 5 0 0 1-10 0c0-4 5-9.3 5-9.3z" />
                                    </Button>
                                    <Button Classes="iconbtn" Click="OnFxButton" ToolTip.Tip="{loc:Loc mainWindow.layerEffects}">
                                        <TextBlock Text="fx" FontStyle="Italic" FontSize="13" Foreground="{DynamicResource ChromeText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Classes="iconbtn" Command="{Binding GroupCommand}" ToolTip.Tip="{loc:Loc mainWindow.groupSelected}">
                                        <Path Classes="icon" Width="14" Height="14"
                                              Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z M12 10v6 M9 13h6" />
                                    </Button>
                                </StackPanel>
                                <!-- right: delete (Affinity puts trash far right) -->
                                <Button Grid.Column="2" Classes="iconbtn" Command="{Binding DeleteLayerCommand}" ToolTip.Tip="{loc:Loc mainWindow.deleteLayer}">
                                    <Path Classes="icon" Width="14" Height="14"
                                          Data="M3 6h18 M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                </Button>
                            </Grid>
                        </Border>
                        <!-- type-to-filter: hides non-matching rows while typing -->
                        <TextBox DockPanel.Dock="Top" Margin="4,3" FontSize="11" Height="{StaticResource ControlHeight}"
                                 PlaceholderText="{loc:Loc mainWindow.filterLayers}"
                                 Text="{Binding LayerFilter, Mode=TwoWay}" />
                        <!-- layer rows (bound, top->bottom); multi-select + drag-drop -->
                        <ListBox x:Name="LayerList" Classes="layers" ItemsSource="{Binding Layers}"
                                 SelectionMode="Multiple"
                                 SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                                 SelectionChanged="OnLayerSelectionChanged"
                                 Background="Transparent" Margin="0,2" Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LayerViewModel">
                                    <!-- Background=Transparent so the WHOLE row hit-tests for right-click
                                         (without it only the text/controls registered the context menu). -->
                                    <DockPanel Height="{StaticResource LayerRowHeight}" LastChildFill="True"
                                               Background="Transparent"
                                               IsVisible="{Binding FilterVisible}">
                                        <DockPanel.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{loc:Loc mainWindow.rename}" Click="OnRenameLayer" />
                                                <MenuItem Header="{loc:Loc mainWindow.duplicate}" Click="OnDuplicate" />
                                                <MenuItem Header="{loc:Loc mainWindow.rasterise}" Click="OnRasterise" />
                                                <!-- float-safe: #LayerList resolves via the XAML namescope, so these keep working
                                                     when the Layers tool is floated into a Dock host window ($parent[Window] would not) -->
                                                <MenuItem Header="{loc:Loc mainWindow.delete}" Command="{Binding #LayerList.((vm:DocumentViewModel)DataContext).DeleteLayerCommand}" />
                                                <Separator />
                                                <MenuItem Header="{loc:Loc mainWindow.groupSelected}" Command="{Binding #LayerList.((vm:DocumentViewModel)DataContext).GroupCommand}" />
                                                <MenuItem Header="{loc:Loc mainWindow.ungroup}" Command="{Binding #LayerList.((vm:DocumentViewModel)DataContext).UngroupCommand}" />
                                                <Separator />
                                                <MenuItem Header="{loc:Loc mainWindow.mergeDown}" Click="OnMergeDown" />
                                                <MenuItem Header="{loc:Loc mainWindow.mergeVisible}" Click="OnMergeVisible" />
                                                <MenuItem Header="{loc:Loc mainWindow.stampVisible}" Click="OnStamp" />
                                                <MenuItem Header="{loc:Loc mainWindow.flattenImage}" Click="OnFlatten" />
                                                <Separator />
                                                <MenuItem Header="{loc:Loc mainWindow.addRemoveMask2}" Command="{Binding #LayerList.((vm:DocumentViewModel)DataContext).ToggleMaskCommand}" />
                                                <Separator />
                                                <MenuItem Header="{loc:Loc mainWindow.copyEffects}" Click="OnCopyEffects" />
                                                <MenuItem Header="{loc:Loc mainWindow.pasteEffects}" Click="OnPasteEffects" />
                                                <MenuItem Header="{loc:Loc mainWindow.clearEffects}" Click="OnClearEffects" />
                                                <Separator />
                                                <MenuItem Header="{loc:Loc mainWindow.transform}">
                                                    <MenuItem Header="{loc:Loc mainWindow.flipHorizontal}" Click="OnFlipH" />
                                                    <MenuItem Header="{loc:Loc mainWindow.flipVertical}" Click="OnFlipV" />
                                                    <Separator />
                                                    <MenuItem Header="{loc:Loc mainWindow.rotate90CW}" Click="OnRotate90CW" />
                                                    <MenuItem Header="{loc:Loc mainWindow.rotate90CCW}" Click="OnRotate90CCW" />
                                                    <MenuItem Header="{loc:Loc mainWindow.rotate180}" Click="OnRotate180" />
                                                    <Separator />
                                                    <MenuItem Header="{loc:Loc mainWindow.resetTransform}" Click="OnResetTransform" />
                                                </MenuItem>
                                                <MenuItem Header="{loc:Loc mainWindow.align}">
                                                    <MenuItem Header="{loc:Loc mainWindow.alignLeft}" Click="OnAlignLeft" />
                                                    <MenuItem Header="{loc:Loc mainWindow.alignCenter}" Click="OnAlignCenterH" />
                                                    <MenuItem Header="{loc:Loc mainWindow.alignRight}" Click="OnAlignRight" />
                                                    <Separator />
                                                    <MenuItem Header="{loc:Loc mainWindow.alignTop}" Click="OnAlignTop" />
                                                    <MenuItem Header="{loc:Loc mainWindow.alignMiddle}" Click="OnAlignMiddle" />
                                                    <MenuItem Header="{loc:Loc mainWindow.alignBottom}" Click="OnAlignBottom" />
                                                    <Separator />
                                                    <MenuItem Header="{loc:Loc mainWindow.distributeHorizontally}" Click="OnDistributeH" />
                                                    <MenuItem Header="{loc:Loc mainWindow.distributeVertically}" Click="OnDistributeV" />
                                                </MenuItem>
                                            </MenuFlyout>
                                        </DockPanel.ContextFlyout>
                                        <!-- colour-tag strip (Affinity) -->
                                        <Border DockPanel.Dock="Left" Width="3" Margin="0,1,3,1" CornerRadius="1"
                                                Background="{Binding TagBrush}" IsVisible="{Binding HasTag}" />
                                        <!-- visibility eye (far right, Affinity-style) -->
                                        <ToggleButton Classes="eye" DockPanel.Dock="Right"
                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                      ToolTip.Tip="{loc:Loc mainWindow.toggleVisibility}">
                                            <Panel>
                                                <Path Classes="icon" Width="14" Height="14" IsVisible="{Binding EffectiveVisible}"
                                                      Data="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z M12 9a3 3 0 1 0 0 6 3 3 0 1 0 0-6z" />
                                                <Path Classes="icon" Width="14" Height="14" Opacity="0.4" IsVisible="{Binding !EffectiveVisible}"
                                                      Data="M2 2l20 20 M10.7 5.1A10.4 10.4 0 0 1 12 5c7 0 10 7 10 7a13 13 0 0 1-1.7 2.7 M6.6 6.6A13.5 13.5 0 0 0 2 12s3 7 10 7a9.7 9.7 0 0 0 5.4-1.6" />
                                            </Panel>
                                        </ToggleButton>
                                        <!-- clip-to-below indicator -->
                                        <Path Classes="icon" DockPanel.Dock="Right" Width="12" Height="12"
                                              Margin="2,0,4,0" VerticalAlignment="Center"
                                              IsVisible="{Binding ClipToBelow}" ToolTip.Tip="{loc:Loc mainWindow.clippedToLayerBelow}"
                                              Data="M9 10l-5 5 5 5 M20 4v7a4 4 0 0 1-4 4H4" />
                                        <!-- thumbnail + name (indented by tree depth) -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Margin="{Binding Indent}" VerticalAlignment="Center">
                                            <!-- nesting guide for indented rows -->
                                            <Border Width="1" Background="{DynamicResource ChromeBorder}" Margin="0,4"
                                                    IsVisible="{Binding IsNested}" />
                                            <!-- group disclosure chevron -->
                                            <Button Classes="iconbtn" Width="14" Height="14" Padding="0"
                                                    Click="OnToggleGroupExpand" IsVisible="{Binding HasChildren}"
                                                    VerticalAlignment="Center">
                                                <Panel>
                                                    <Path Classes="icon" Width="12" Height="12" IsVisible="{Binding IsExpanded}"
                                                          Data="M6 9l6 6 6-6" />
                                                    <Path Classes="icon" Width="12" Height="12" IsVisible="{Binding !IsExpanded}"
                                                          Data="M9 6l6 6-6 6" />
                                                </Panel>
                                            </Button>
                                            <Border Width="30" Height="24" CornerRadius="2" Background="{DynamicResource ChromeField}"
                                                    BorderBrush="#FF454545" BorderThickness="1" VerticalAlignment="Center">
                                                <ToolTip.Tip>
                                                    <Image Source="{Binding Thumbnail}" Width="144" Height="108"
                                                           Stretch="Uniform" IsVisible="{Binding IsPixel}" />
                                                </ToolTip.Tip>
                                                <Panel>
                                                    <Image Source="{Binding Thumbnail}" Width="30" Height="24"
                                                           Stretch="Fill" IsVisible="{Binding IsPixel}" />
                                                    <Path Classes="icon" Width="14" Height="14" IsVisible="{Binding IsGroup}"
                                                          Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z" />
                                                    <Path Classes="icon" Width="16" Height="14" IsVisible="{Binding IsAdjustment}"
                                                          Data="M21 4H14 M10 4H3 M21 12H12 M8 12H3 M21 20H16 M12 20H3 M14 2v4 M8 10v4 M16 18v4" />
                                                    <Path Classes="icon" Width="15" Height="16" IsVisible="{Binding IsFilter}"
                                                          Data="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5S5 13 5 15a7 7 0 0 0 7 7z" />
                                                    <Path Classes="icon" Width="14" Height="14" IsVisible="{Binding IsShape}"
                                                          Data="M4 4h16v16H4z" />
                                                    <Path Classes="icon" Width="14" Height="14" IsVisible="{Binding IsText}"
                                                          Data="M4 7V4h16v3 M9 20h6 M12 4v16" />
                                                </Panel>
                                            </Border>
                                            <!-- name: TextBlock display, swapped for an inline TextBox while renaming -->
                                            <Panel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ChromeText}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           IsVisible="{Binding !IsEditing}"
                                                           DoubleTapped="OnLayerNameDoubleTapped" />
                                                <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="12"
                                                         MinHeight="0" Height="20" Padding="3,0" Margin="0"
                                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                         AcceptsReturn="False" IsVisible="{Binding IsEditing}"
                                                         KeyDown="OnLayerNameKeyDown" LostFocus="OnLayerNameCommit" />
                                            </Panel>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </DockPanel>
                        </Panel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>

    <!-- drag ghost overlay (follows cursor while dragging a layer) -->
    <Canvas x:Name="DragLayer" IsHitTestVisible="False">
        <!-- between-row drop indicator -->
        <Border x:Name="DropIndicator" IsVisible="False" Height="2" Background="{DynamicResource ChromeAccent}" />
        <!-- drop-into / auto-group highlight (outline of the target row) -->
        <Border x:Name="DropIntoBox" IsVisible="False" BorderBrush="{DynamicResource ChromeAccent}" BorderThickness="2"
                CornerRadius="3" Background="#332D7FF9" />
        <Border x:Name="DragGhost" IsVisible="False" Background="#E6303030"
                BorderBrush="#FF2D7FF9" BorderThickness="1" CornerRadius="3" Padding="8,4">
            <TextBlock x:Name="DragGhostText" Foreground="White" FontSize="12" />
        </Border>
    </Canvas>
    </Panel>
</Window>
