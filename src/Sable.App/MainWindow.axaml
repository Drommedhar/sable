<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:canvas="clr-namespace:Sable.Canvas;assembly=Sable.Canvas"
        xmlns:vm="clr-namespace:Sable.UI.ViewModels;assembly=Sable.UI"
        xmlns:eng="clr-namespace:Sable.Engine.Layers;assembly=Sable.Engine"
        xmlns:local="clr-namespace:Sable.App"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="Sable.App.MainWindow"
        x:DataType="vm:DocumentViewModel"
        Width="1280" Height="760"
        Background="{DynamicResource ChromeWindowBg}"
        Icon="avares://Sable.App/Assets/sable.ico"
        Title="Sable">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoEditCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoEditCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoEditCommand}" />
    </Window.KeyBindings>

    <!-- PS/Affinity-style chrome skeleton (PLAN §13). Real dockable panels (Dock.Avalonia)
         and the embedded wgpu canvas surface land in later milestones. -->
    <Panel>
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- (4) Menu bar — brand logo at left, like Affinity -->
        <DockPanel Grid.Row="0" Background="{DynamicResource ChromeMenuBg}">
        <Image DockPanel.Dock="Left" Source="avares://Sable.App/Assets/logo_only.png"
               Height="18" Stretch="Uniform" Margin="12,5,12,5" VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               ToolTip.Tip="Sable" />
        <Menu>
            <MenuItem Header="_File">
                <MenuItem Header="New..." Click="OnNewMenu" InputGesture="Ctrl+N" />
                <MenuItem Header="New from Clipboard" Click="OnNewFromClipboard" />
                <Separator />
                <MenuItem Header="Open..." Click="OnOpenSable" InputGesture="Ctrl+O" />
                <MenuItem Header="Open Image..." Click="OnOpenImage" />
                <MenuItem Header="Open Recent" x:Name="RecentMenu" />
                <Separator />
                <MenuItem Header="Save" Click="OnSaveSable" InputGesture="Ctrl+S" />
                <MenuItem Header="Save As..." Click="OnSaveAsSable" />
                <Separator />
                <MenuItem Header="Export..." Click="OnExport" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" Command="{Binding UndoEditCommand}" InputGesture="Ctrl+Z" />
                <MenuItem Header="Redo" Command="{Binding RedoEditCommand}" InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Cut" Click="OnCut" InputGesture="Ctrl+X" />
                <MenuItem Header="Copy" Click="OnCopy" InputGesture="Ctrl+C" />
                <MenuItem Header="Copy Merged" Click="OnCopyMerged" InputGesture="Ctrl+Shift+C" />
                <MenuItem Header="Paste" Click="OnPaste" InputGesture="Ctrl+V" />
                <MenuItem Header="Paste Into" Click="OnPasteInto" InputGesture="Ctrl+Shift+V" />
                <MenuItem Header="Duplicate Layer" Click="OnDuplicate" InputGesture="Ctrl+J" />
                <Separator />
                <MenuItem Header="Preferences..." Click="OnPreferences" />
            </MenuItem>
            <MenuItem Header="_Image">
                <MenuItem Header="Resize Document..." Click="OnResizeDocument" />
                <MenuItem Header="Resize Canvas..." Click="OnResizeCanvas" />
            </MenuItem>
            <MenuItem Header="_Layer">
                <MenuItem Header="Duplicate" Click="OnDuplicate" InputGesture="Ctrl+J" />
                <MenuItem Header="Rasterise" Click="OnRasterise" />
                <Separator />
                <MenuItem Header="Merge Down" Click="OnMergeDown" InputGesture="Ctrl+E" />
                <MenuItem Header="Merge Visible" Click="OnMergeVisible" InputGesture="Ctrl+Shift+E" />
                <MenuItem Header="Stamp Visible" Click="OnStamp" InputGesture="Ctrl+Shift+Alt+E" />
                <MenuItem Header="Flatten Image" Click="OnFlatten" />
            </MenuItem>
            <MenuItem Header="_Select" />
            <MenuItem Header="_Filter">
                <MenuItem Header="Gaussian Blur" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.GaussianBlur}" />
                <MenuItem Header="Box Blur" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.BoxBlur}" />
                <MenuItem Header="Motion Blur" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.MotionBlur}" />
                <MenuItem Header="Zoom Blur" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.ZoomBlur}" />
                <Separator />
                <MenuItem Header="Sharpen" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.Sharpen}" />
                <MenuItem Header="Unsharp Mask" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.UnsharpMask}" />
                <MenuItem Header="High Pass" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.HighPass}" />
                <MenuItem Header="Clarity" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.Clarity}" />
                <Separator />
                <MenuItem Header="Add Noise" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.AddNoise}" />
                <MenuItem Header="Denoise" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.Denoise}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom In" Click="OnZoomInMenu" InputGesture="Ctrl+OemPlus" />
                <MenuItem Header="Zoom Out" Click="OnZoomOutMenu" InputGesture="Ctrl+OemMinus" />
                <MenuItem Header="Fit to Window" Click="OnZoomFit" InputGesture="Ctrl+D0" />
                <MenuItem Header="Actual Pixels (100%)" Click="OnZoomActual" InputGesture="Ctrl+D1" />
                <Separator />
                <MenuItem x:Name="GridMenuItem" Header="Show Grid" ToggleType="CheckBox" Click="OnToggleGrid" />
                <MenuItem x:Name="PixelGridMenuItem" Header="Show Pixel Grid" ToggleType="CheckBox" IsChecked="True" Click="OnTogglePixelGrid" />
            </MenuItem>
            <MenuItem Header="_Window">
                <MenuItem Header="Adjustments" Click="OnToggleAdjustments" />
                <MenuItem Header="Layer Effects" Click="OnToggleEffects" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for Updates..." Click="OnCheckUpdatesMenu" />
                <Separator />
                <MenuItem Header="About Sable" Click="OnAbout" />
            </MenuItem>
        </Menu>
        </DockPanel>

        <!-- (3) Context / options bar -->
        <Border Grid.Row="1" Background="{DynamicResource ChromePanel2}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1" Height="{StaticResource OptionsBarHeight}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0" Spacing="8">
                <TextBlock x:Name="ToolStatus" Text="Brush" Foreground="{DynamicResource ChromeText}" VerticalAlignment="Center" Width="76" />

                <!-- brush/eraser/clone/shape-line: stroke size -->
                <StackPanel x:Name="SizeOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="Size" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <Slider x:Name="BrushSizeSlider" Width="120" Minimum="1" Maximum="200" Value="16"
                            ValueChanged="OnBrushSizeChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="BrushSizeLabel" Text="16 px" Foreground="{DynamicResource ChromeTextDim}"
                               VerticalAlignment="Center" FontSize="11" Width="44" />
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="Hardness" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <Slider x:Name="BrushHardnessSlider" Width="90" Minimum="0" Maximum="100" Value="50"
                            ValueChanged="OnBrushHardnessChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="BrushHardnessLabel" Text="50%" Foreground="{DynamicResource ChromeTextDim}"
                               VerticalAlignment="Center" FontSize="11" Width="36" />
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="Flow" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <Slider x:Name="BrushFlowSlider" Width="90" Minimum="1" Maximum="100" Value="100"
                            ValueChanged="OnBrushFlowChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="BrushFlowLabel" Text="100%" Foreground="{DynamicResource ChromeTextDim}"
                               VerticalAlignment="Center" FontSize="11" Width="36" />
                </StackPanel>

                <!-- retouch brushes: effect strength -->
                <StackPanel x:Name="StrengthOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="Strength" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <Slider x:Name="StrengthSlider" Width="120" Minimum="1" Maximum="100" Value="50"
                            ValueChanged="OnStrengthChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="StrengthLabel" Text="50%" Foreground="{DynamicResource ChromeTextDim}"
                               VerticalAlignment="Center" FontSize="11" Width="40" />
                </StackPanel>

                <!-- selection tools: feather -->
                <StackPanel x:Name="SelectOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="Feather" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <Slider x:Name="FeatherSlider" Width="110" Minimum="0" Maximum="50" Value="0"
                            ValueChanged="OnFeatherChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="FeatherLabel" Text="0 px" Foreground="{DynamicResource ChromeTextDim}"
                               VerticalAlignment="Center" FontSize="11" Width="40" />
                </StackPanel>

                <!-- type tool: font controls -->
                <StackPanel x:Name="TypeOpts" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <ComboBox x:Name="FontCombo" Width="150" FontSize="11" VerticalAlignment="Center"
                              SelectionChanged="OnFontChanged" />
                    <ToggleButton Classes="opt" x:Name="BoldBtn" Content="B" Width="26" Height="24" FontWeight="Bold"
                                  VerticalAlignment="Center" Click="OnFontStyleChanged" ToolTip.Tip="Bold" />
                    <ToggleButton Classes="opt" x:Name="ItalicBtn" Content="I" Width="26" Height="24" FontStyle="Italic"
                                  VerticalAlignment="Center" Click="OnFontStyleChanged" ToolTip.Tip="Italic" />
                    <ToggleButton Classes="opt" x:Name="UnderlineBtn" Content="U" Width="26" Height="24"
                                  VerticalAlignment="Center" Click="OnFontStyleChanged" ToolTip.Tip="Underline" />
                    <ToggleButton Classes="opt" x:Name="StrikeBtn" Content="S" Width="26" Height="24"
                                  VerticalAlignment="Center" Click="OnFontStyleChanged" ToolTip.Tip="Strikethrough" />
                    <TextBox x:Name="TypeSizeBox" Width="48" Text="48" TextAlignment="Center"
                             TextChanged="OnTypeSizeChanged"
                             VerticalAlignment="Center" ToolTip.Tip="Font size" />
                    <ToggleButton Classes="opt" x:Name="AlignLeftBtn" Width="26" Height="24" VerticalAlignment="Center"
                                  Click="OnAlignChanged" Tag="0" ToolTip.Tip="Align left">
                        <Path Classes="icon" Width="14" Height="14" Data="M3 6h18 M3 12h12 M3 18h15" />
                    </ToggleButton>
                    <ToggleButton Classes="opt" x:Name="AlignCenterBtn" Width="26" Height="24" VerticalAlignment="Center"
                                  Click="OnAlignChanged" Tag="1" ToolTip.Tip="Align center">
                        <Path Classes="icon" Width="14" Height="14" Data="M3 6h18 M6 12h12 M4 18h16" />
                    </ToggleButton>
                    <ToggleButton Classes="opt" x:Name="AlignRightBtn" Width="26" Height="24" VerticalAlignment="Center"
                                  Click="OnAlignChanged" Tag="2" ToolTip.Tip="Align right">
                        <Path Classes="icon" Width="14" Height="14" Data="M3 6h18 M9 12h12 M6 18h15" />
                    </ToggleButton>
                    <TextBox x:Name="LineSpacingBox" Width="48" Text="100" TextAlignment="Center"
                             TextChanged="OnLineSpacingChanged"
                             VerticalAlignment="Center" ToolTip.Tip="Line spacing %" />
                </StackPanel>

                <!-- eyedropper: sample size + source -->
                <StackPanel x:Name="EyedropperOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="Sample" Foreground="{DynamicResource ChromeTextDim}" VerticalAlignment="Center" FontSize="11" />
                    <ComboBox x:Name="EyedropperSampleCombo" Width="84" SelectedIndex="0" SelectionChanged="OnEyedropperSampleChanged">
                        <ComboBoxItem>Point</ComboBoxItem>
                        <ComboBoxItem>3 x 3</ComboBoxItem>
                        <ComboBoxItem>5 x 5</ComboBoxItem>
                    </ComboBox>
                    <CheckBox Content="All layers" FontSize="11" Foreground="{DynamicResource ChromeText}"
                              IsChecked="False" IsCheckedChanged="OnEyedropperAllLayersChanged" />
                </StackPanel>

                <!-- brush/eraser: mask-edit hint -->
                <StackPanel x:Name="MaskHint" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ChromeBorder}" />
                    <TextBlock Text="(K = edit mask)" Foreground="{DynamicResource ChromeTextFaint}" VerticalAlignment="Center" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main work area: (2) tools | (1) canvas | (5/6) panels -->
        <Grid Grid.Row="2" ColumnDefinitions="40,*,300">

            <!-- (2) Tool palette -->
            <Border Grid.Column="0" Background="{DynamicResource ChromePanel}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,1,0">
                <!-- tool strip is generated in code (grouped slots + flyouts), see BuildToolStrip() -->
                <StackPanel x:Name="ToolStrip" Margin="0,6" HorizontalAlignment="Center" />
            </Border>

            <!-- (1) Canvas area: document tabs + GPU surface mount point -->
            <Grid Grid.Column="1" RowDefinitions="28,*,22" Background="{DynamicResource ChromeCanvas}">
                <!-- document tabs (multi-doc) -->
                <Border Grid.Row="0" Background="{DynamicResource ChromePanel2}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="6,0">
                        <ItemsControl x:Name="TabStrip" VerticalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:DocumentTab">
                                    <Border Padding="10,0,6,0" Margin="2,4,0,0" CornerRadius="4,4,0,0"
                                            PointerPressed="OnSelectTab" Tag="{Binding}"
                                            Background="{Binding IsActive, Converter={x:Static local:BoolToTabBgConverter.Instance}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource ChromeText}" FontSize="12" VerticalAlignment="Center" />
                                            <Button Classes="iconbtn" Width="16" Height="16" Padding="0" Click="OnCloseTab" Tag="{Binding}"
                                                    ToolTip.Tip="Close tab" VerticalAlignment="Center">
                                                <TextBlock Text="×" FontSize="13" Foreground="{DynamicResource ChromeTextDim}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="iconbtn" Width="22" Click="OnNewTabButton" ToolTip.Tip="New document" VerticalAlignment="Center" Margin="4,0,0,0">
                            <Path Classes="icon" Width="14" Height="14" Data="M12 5v14 M5 12h14" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- canvas viewport: live embedded wgpu swapchain + input overlay -->
                <Border Grid.Row="1" Margin="24" Background="{DynamicResource ChromeCanvas}"
                        BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1">
                    <Panel>
                        <canvas:GpuSurfaceControl x:Name="Canvas" />
                        <Border x:Name="InputLayer" Background="Transparent"
                                PointerWheelChanged="OnCanvasWheel"
                                PointerPressed="OnCanvasPointerPressed"
                                PointerMoved="OnCanvasPointerMoved"
                                PointerReleased="OnCanvasPointerReleased"
                                DoubleTapped="OnCanvasDoubleTapped" />
                        <!-- empty / welcome state (no open document) -->
                        <StackPanel x:Name="EmptyState" IsVisible="False" Spacing="10"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="No document open" Foreground="{DynamicResource ChromeTextFaint}" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="File ▸ New (Ctrl+N) · Open · New from Clipboard · or drop an image"
                                       Foreground="#FF5A5A5A" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Panel>
                </Border>

                <!-- status strip: live zoom UI + document info + cursor position -->
                <Border Grid.Row="2" Background="{DynamicResource ChromePanel2}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0" Spacing="10">
                        <Button Classes="iconbtn" Width="24" Height="20" Click="OnZoomFit" ToolTip.Tip="Fit (0)">
                            <Path Classes="icon" Width="13" Height="13" Data="M3 8V3h5 M16 3h5v5 M21 16v5h-5 M8 21H3v-5" />
                        </Button>
                        <Button Classes="iconbtn" Width="24" Height="20" Click="OnZoomActual" ToolTip.Tip="100%">
                            <TextBlock Text="1:1" FontSize="10" Foreground="{DynamicResource ChromeText}" />
                        </Button>
                        <TextBox x:Name="ZoomBox" Width="54" Text="100%" FontSize="11" TextAlignment="Center"
                                 VerticalContentAlignment="Center" KeyDown="OnZoomBoxKey" ToolTip.Tip="Zoom level" />
                        <Rectangle Width="1" Height="14" Fill="{DynamicResource ChromeBorder}" />
                        <TextBlock x:Name="DocInfoLabel" Text="—" Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" />
                        <Rectangle Width="1" Height="14" Fill="{DynamicResource ChromeBorder}" />
                        <TextBlock x:Name="CursorLabel" Text="" Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" Width="110" />
                        <TextBlock Text="RGBA/16f linear" Foreground="{DynamicResource ChromeTextFaint}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- (5/6) Right panel stack: Color/Swatches + Layers -->
            <Border Grid.Column="2" Background="{DynamicResource ChromePanel}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- (6) Color / Gradients / Swatches -->
                    <DockPanel Grid.Row="0">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeFooter}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TabColor" Classes="panelHeader" Text="Color"
                                           Tapped="OnSelectColorTab" Tag="color" />
                                <TextBlock x:Name="TabGrad" Classes="panelHeader" Text="Gradients"
                                           Foreground="{DynamicResource ChromeTextFaint}" Tapped="OnSelectColorTab" Tag="grad" />
                                <TextBlock Classes="panelHeader" Text="Swatches" Foreground="{DynamicResource ChromeTextFaint}" />
                            </StackPanel>
                        </Border>
                        <!-- gradient editor (Gradients tab): draggable stop bar + add/remove -->
                        <StackPanel x:Name="GradientPanel" DockPanel.Dock="Bottom" IsVisible="False"
                                    Margin="6,2,6,6" Spacing="4">
                            <local:GradientBar x:Name="GradBar" Height="42" />
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="iconbtn" Click="OnGradAddStop" ToolTip.Tip="Add stop">
                                    <Path Classes="icon" Width="14" Height="14" Data="M12 5v14 M5 12h14" />
                                </Button>
                                <Button Classes="iconbtn" Click="OnGradDelStop" ToolTip.Tip="Delete selected stop">
                                    <Path Classes="icon" Width="14" Height="14" Data="M5 12h14" />
                                </Button>
                                <TextBlock Text="click bar = add · drag = move · wheel sets stop colour"
                                           Foreground="{DynamicResource ChromeTextFaint}" FontSize="10" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Width="200" />
                            </StackPanel>
                        </StackPanel>
                        <local:ColorPicker x:Name="BrushColorView" Margin="8,8,8,6" VerticalAlignment="Top" />
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="4" Background="{DynamicResource ChromeWindowBg}"
                                  HorizontalAlignment="Stretch" />

                    <!-- (5) Layers / Channels / Paths -->
                    <DockPanel Grid.Row="2">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeFooter}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="panelHeader" Text="Layers" />
                                <TextBlock Classes="panelHeader" Text="Channels" Foreground="{DynamicResource ChromeTextFaint}" />
                                <TextBlock Classes="panelHeader" Text="Paths" Foreground="{DynamicResource ChromeTextFaint}" />
                            </StackPanel>
                        </Border>
                        <!-- blend mode + opacity row (bound to selected layer) -->
                        <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource ChromePanel3}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox Width="130" FontSize="11"
                                              ItemsSource="{Binding BlendModes}"
                                              SelectedItem="{Binding SelectedLayer.BlendMode, Mode=TwoWay}" />
                                    <TextBlock Text="{Binding SelectedLayer.OpacityLabel}"
                                               Foreground="{DynamicResource ChromeTextDim}" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <Slider Minimum="0" Maximum="100"
                                        Value="{Binding SelectedLayer.OpacityPercent, Mode=TwoWay}" />
                                <TextBlock Text="{Binding SelectedLayer.FillOpacityLabel}"
                                           Foreground="{DynamicResource ChromeTextDim}" FontSize="11" />
                                <Slider Minimum="0" Maximum="100"
                                        Value="{Binding SelectedLayer.FillOpacityPercent, Mode=TwoWay}" />
                                <CheckBox Content="Clip to layer below" FontSize="11" Foreground="{DynamicResource ChromeText}"
                                          IsChecked="{Binding SelectedLayer.ClipToBelow, Mode=TwoWay}" />
                                <!-- locks + colour tag (act on the selected layer) -->
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Lock:" Foreground="{DynamicResource ChromeTextDim}" FontSize="10" VerticalAlignment="Center" />
                                    <ToggleButton Classes="opt" Width="26" Content="Pos" FontSize="10"
                                                  ToolTip.Tip="Lock position / transform"
                                                  IsChecked="{Binding SelectedLayer.LockPosition, Mode=TwoWay}" />
                                    <ToggleButton Classes="opt" Width="26" Content="Pix" FontSize="10"
                                                  ToolTip.Tip="Lock pixels"
                                                  IsChecked="{Binding SelectedLayer.LockPixels, Mode=TwoWay}" />
                                    <ToggleButton Classes="opt" Width="22" Content="α" FontSize="11"
                                                  ToolTip.Tip="Lock transparency (preserve alpha)"
                                                  IsChecked="{Binding SelectedLayer.LockAlpha, Mode=TwoWay}" />
                                    <Border Width="8" />
                                    <ItemsControl ItemsSource="{Binding TagSwatches}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TagSwatch">
                                                <Button Width="14" Height="14" Padding="0" CornerRadius="7"
                                                        Background="{Binding Brush}" BorderBrush="#FF555555" BorderThickness="1"
                                                        Click="OnSetTag" Tag="{Binding Index}" ToolTip.Tip="Colour tag" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- adjustment params now live in the modeless AdjustmentWindow (Window menu) -->
                        <!-- footer buttons (bound to undoable layer commands) -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeFooter}" Padding="6,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- left cluster: add layer / mask / adjustments / live filters / group -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                    <Button Classes="iconbtn" Command="{Binding NewLayerCommand}" ToolTip.Tip="New pixel layer">
                                        <Path Classes="icon" Width="16" Height="16" Data="M12 5v14 M5 12h14" />
                                    </Button>
                                    <Button Classes="iconbtn" Command="{Binding ToggleMaskCommand}" ToolTip.Tip="Add / remove mask">
                                        <Path Classes="icon" Width="16" Height="16"
                                              Data="M4 4h16v16H4z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                                    </Button>
                                    <!-- adjustments flyout (Affinity half-circle) -->
                                    <Button Classes="iconbtn" ToolTip.Tip="Add adjustment">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Brightness / Contrast" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.BrightnessContrast}" />
                                                <MenuItem Header="Levels" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Levels}" />
                                                <MenuItem Header="Curves" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Curves}" />
                                                <MenuItem Header="HSL" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Hsl}" />
                                                <MenuItem Header="White Balance" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.WhiteBalance}" />
                                                <MenuItem Header="Black &amp; White" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.BlackWhite}" />
                                                <MenuItem Header="Colour Balance" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.ColorBalance}" />
                                                <MenuItem Header="Channel Mixer" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.ChannelMixer}" />
                                                <MenuItem Header="Shadows / Highlights" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.ShadowsHighlights}" />
                                                <Separator />
                                                <MenuItem Header="Exposure" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Exposure}" />
                                                <MenuItem Header="Vibrance" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Vibrance}" />
                                                <MenuItem Header="Threshold" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Threshold}" />
                                                <MenuItem Header="Posterise" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Posterize}" />
                                                <MenuItem Header="Invert" Command="{Binding NewAdjustmentCommand}" CommandParameter="{x:Static eng:AdjustmentKind.Invert}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <Path Classes="icon" Width="16" Height="16"
                                              Data="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 3v18" />
                                    </Button>
                                    <!-- live filters flyout -->
                                    <Button Classes="iconbtn" ToolTip.Tip="Add live filter">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Gaussian Blur" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.GaussianBlur}" />
                                                <MenuItem Header="Box Blur" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.BoxBlur}" />
                                                <MenuItem Header="Motion Blur" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.MotionBlur}" />
                                                <MenuItem Header="Zoom Blur" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.ZoomBlur}" />
                                                <Separator />
                                                <MenuItem Header="Sharpen" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.Sharpen}" />
                                                <MenuItem Header="Unsharp Mask" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.UnsharpMask}" />
                                                <MenuItem Header="High Pass" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.HighPass}" />
                                                <MenuItem Header="Clarity" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.Clarity}" />
                                                <Separator />
                                                <MenuItem Header="Add Noise" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.AddNoise}" />
                                                <MenuItem Header="Denoise" Command="{Binding NewFilterCommand}" CommandParameter="{x:Static eng:FilterKind.Denoise}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <Path Classes="icon" Width="16" Height="16"
                                              Data="M12 2.7s5 5.3 5 9.3a5 5 0 0 1-10 0c0-4 5-9.3 5-9.3z" />
                                    </Button>
                                    <Button Classes="iconbtn" Click="OnFxButton" ToolTip.Tip="Layer Effects">
                                        <TextBlock Text="fx" FontStyle="Italic" FontSize="13" Foreground="{DynamicResource ChromeText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Classes="iconbtn" Command="{Binding GroupCommand}" ToolTip.Tip="Group selected">
                                        <Path Classes="icon" Width="16" Height="16"
                                              Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z M12 10v6 M9 13h6" />
                                    </Button>
                                </StackPanel>
                                <!-- right: delete (Affinity puts trash far right) -->
                                <Button Grid.Column="2" Classes="iconbtn" Command="{Binding DeleteLayerCommand}" ToolTip.Tip="Delete layer">
                                    <Path Classes="icon" Width="16" Height="16"
                                          Data="M3 6h18 M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                </Button>
                            </Grid>
                        </Border>
                        <!-- layer rows (bound, top->bottom); multi-select + drag-drop -->
                        <ListBox x:Name="LayerList" Classes="layers" ItemsSource="{Binding Layers}"
                                 SelectionMode="Multiple"
                                 SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                                 SelectionChanged="OnLayerSelectionChanged"
                                 Background="Transparent" Margin="0,2" Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LayerViewModel">
                                    <DockPanel Height="{StaticResource LayerRowHeight}" LastChildFill="True">
                                        <!-- colour-tag strip (Affinity) -->
                                        <Border DockPanel.Dock="Left" Width="3" Margin="0,1,3,1" CornerRadius="1"
                                                Background="{Binding TagBrush}" IsVisible="{Binding HasTag}" />
                                        <!-- visibility eye (far right, Affinity-style) -->
                                        <ToggleButton Classes="eye" DockPanel.Dock="Right"
                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                      ToolTip.Tip="Toggle visibility">
                                            <Panel>
                                                <Path Classes="icon" Width="16" Height="16" IsVisible="{Binding IsVisible}"
                                                      Data="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z M12 9a3 3 0 1 0 0 6 3 3 0 1 0 0-6z" />
                                                <Path Classes="icon" Width="16" Height="16" Opacity="0.4" IsVisible="{Binding !IsVisible}"
                                                      Data="M2 2l20 20 M10.7 5.1A10.4 10.4 0 0 1 12 5c7 0 10 7 10 7a13 13 0 0 1-1.7 2.7 M6.6 6.6A13.5 13.5 0 0 0 2 12s3 7 10 7a9.7 9.7 0 0 0 5.4-1.6" />
                                            </Panel>
                                        </ToggleButton>
                                        <!-- clip-to-below indicator -->
                                        <Path Classes="icon" DockPanel.Dock="Right" Width="12" Height="12"
                                              Margin="2,0,4,0" VerticalAlignment="Center"
                                              IsVisible="{Binding ClipToBelow}" ToolTip.Tip="Clipped to layer below"
                                              Data="M9 10l-5 5 5 5 M20 4v7a4 4 0 0 1-4 4H4" />
                                        <!-- thumbnail + name (indented by tree depth) -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Margin="{Binding Indent}" VerticalAlignment="Center">
                                            <!-- nesting guide for indented rows -->
                                            <Border Width="1" Background="{DynamicResource ChromeBorder}" Margin="0,4"
                                                    IsVisible="{Binding IsNested}" />
                                            <!-- group disclosure chevron -->
                                            <Button Classes="iconbtn" Width="16" Height="16" Padding="0"
                                                    Click="OnToggleGroupExpand" IsVisible="{Binding IsGroup}"
                                                    VerticalAlignment="Center">
                                                <Panel>
                                                    <Path Classes="icon" Width="12" Height="12" IsVisible="{Binding IsExpanded}"
                                                          Data="M6 9l6 6 6-6" />
                                                    <Path Classes="icon" Width="12" Height="12" IsVisible="{Binding !IsExpanded}"
                                                          Data="M9 6l6 6-6 6" />
                                                </Panel>
                                            </Button>
                                            <Border Width="30" Height="24" CornerRadius="2" Background="{DynamicResource ChromeField}"
                                                    BorderBrush="#FF454545" BorderThickness="1" VerticalAlignment="Center">
                                                <Panel>
                                                    <Image Source="{Binding Thumbnail}" Width="30" Height="24"
                                                           Stretch="Fill" IsVisible="{Binding IsPixel}" />
                                                    <Path Classes="icon" Width="16" Height="16" IsVisible="{Binding IsGroup}"
                                                          Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z" />
                                                    <Path Classes="icon" Width="16" Height="14" IsVisible="{Binding IsAdjustment}"
                                                          Data="M21 4H14 M10 4H3 M21 12H12 M8 12H3 M21 20H16 M12 20H3 M14 2v4 M8 10v4 M16 18v4" />
                                                    <Path Classes="icon" Width="15" Height="16" IsVisible="{Binding IsFilter}"
                                                          Data="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5S5 13 5 15a7 7 0 0 0 7 7z" />
                                                    <Path Classes="icon" Width="16" Height="16" IsVisible="{Binding IsShape}"
                                                          Data="M4 4h16v16H4z" />
                                                    <Path Classes="icon" Width="16" Height="16" IsVisible="{Binding IsText}"
                                                          Data="M4 7V4h16v3 M9 20h6 M12 4v16" />
                                                </Panel>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ChromeText}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- bottom app status bar -->
        <Border Grid.Row="3" Background="#FF007ACC" Height="{StaticResource StatusBarHeight}">
            <TextBlock Text="Sable — M0 spike build" Foreground="White" FontSize="11"
                       VerticalAlignment="Center" Margin="8,0" />
        </Border>
    </Grid>

    <!-- drag ghost overlay (follows cursor while dragging a layer) -->
    <Canvas x:Name="DragLayer" IsHitTestVisible="False">
        <!-- between-row drop indicator -->
        <Border x:Name="DropIndicator" IsVisible="False" Height="2" Background="#FF2D7FF9" />
        <Border x:Name="DragGhost" IsVisible="False" Background="#E6303030"
                BorderBrush="#FF2D7FF9" BorderThickness="1" CornerRadius="3" Padding="8,4">
            <TextBlock x:Name="DragGhostText" Foreground="White" FontSize="12" />
        </Border>
    </Canvas>
    </Panel>
</Window>
