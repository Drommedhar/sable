<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Sable.App.Localization"
        x:Class="Sable.App.ConfirmWindow"
        Width="340" SizeToContent="Height"
        Background="{DynamicResource ChromePanel}"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc confirmWindow.confirm}">
    <Border Padding="16">
        <StackPanel Spacing="12">
            <TextBlock x:Name="TitleText" Classes="panelHeader" Padding="0" />
            <TextBlock x:Name="BodyText" Foreground="{DynamicResource ChromeText}" FontSize="12" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc confirmWindow.cancel}" Classes="opt" Padding="14,0" Click="OnCancel" />
                <Button Content="{loc:Loc confirmWindow.discard}" Classes="opt" Padding="14,0" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
