<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sable.Core\Sable.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the Python server beside the app; the sidecar process runs it under the resolved venv. -->
    <None Include="server\**\*.py" CopyToOutputDirectory="PreserveNewest" LinkBase="server" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
